[Unit]
Description=RigPi Elmer cloud pilot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=elmer
Group=elmer
WorkingDirectory=/opt/elmer/app
Environment=CREDENTIALS_DIRECTORY=/etc/elmer
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/elmer/venv/bin/python /opt/elmer/app/elmer_web.py --host 127.0.0.1 --port 8091 --db /opt/elmer/data/knowledge.db --feedback-db /opt/elmer/state/feedback.db
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0027
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
