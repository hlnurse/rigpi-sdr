[Unit]
Description=RigPi Elmer question-and-answer service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/Elmer
ExecStart=/usr/bin/python3 /home/pi/Elmer/elmer_web.py --host 127.0.0.1 --port 8090
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
