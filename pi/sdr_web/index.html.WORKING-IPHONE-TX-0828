      // ── BW drag helpers ──────────────────────────────────────────────────

      // Return {left, right} CSS-px of BW edges, respecting CW independent edges.
      function _bwEdgeXsCss() {
        const rect = spCanvas.getBoundingClientRect();
        const wCss = rect.width;
        const span = Number(state.span);
        const bw = Number(state.bw);
        const mode = String(state.mode || "").toUpperCase();
        if (!wCss || !span || !bw) return null;
        const pxPerHz = wCss / span;
        const cx = wCss / 2;
        let leftHz, rightHz;
        if (mode === "CW") {
          leftHz = (state.cwPitch || 600) - state.cwLowHz;
          rightHz = (state.cwPitch || 600) + state.cwHighHz;
        } else if (mode === "CWR") {
          leftHz = -(state.cwPitch || 600) - state.cwHighHz;
          rightHz = -(state.cwPitch || 600) + state.cwLowHz;
        } else {
          const off = computeBwOffsetHz(mode, bw);
          leftHz = off - bw / 2;
          rightHz = off + bw / 2;
        }
        return {
          left: cx + leftHz * pxPerHz,
          right: cx + rightHz * pxPerHz,
          leftHz,
          rightHz,
        };
      }

      function _bwHitEdge(xCss) {
        const edges = _bwEdgeXsCss();
        if (!edges) return null;
        const mode = String(state.mode || "").toUpperCase();
        const hit = 8;
        const nearLeft = Math.abs(xCss - edges.left) < hit;
        const nearRight = Math.abs(xCss - edges.right) < hit;
        if (mode === "USB" || mode === "PKTUSB")
          return nearRight ? "right" : null;
        if (mode === "LSB") return nearLeft ? "left" : null;
        if (nearLeft) return "left";
        if (nearRight) return "right";
        return null;
      }

