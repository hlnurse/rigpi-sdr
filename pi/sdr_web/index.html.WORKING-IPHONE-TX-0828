      // ---- ALSA Loopback ----
      (function initLoopback() {
        const sel = document.getElementById("loopbackDevice");
        const btn = document.getElementById("loopbackToggle");
        const status = document.getElementById("loopbackStatus");
        if (!btn || !sel) return;

        let loopbackRunning = false;

        // Load device list
        fetch((window._sdrBase || "") + "/api/audio/loopback")
          .then((r) => r.json())
          .then((d) => {
            sel.innerHTML = "";
            (d.devices || []).forEach((dev) => {
              const opt = document.createElement("option");
              opt.value = dev.index;
              opt.textContent = dev.name;
              sel.appendChild(opt);
            });
            for (const opt of sel.options) {
              if (opt.textContent.toLowerCase().includes("loopback")) {
                opt.selected = true;
                break;
              }
            }
            // Restore previously selected device
            const savedDev = localStorage.getItem("loopbackDevice");
            if (savedDev) {
              for (const opt of sel.options) {
                if (opt.value === savedDev) {
                  opt.selected = true;
                  break;
                }
              }
            }
            if (d.running) {
              loopbackRunning = true;
              btn.textContent = "Stop";
              btn.style.background = "#c0392b";
              status.textContent = "Running on device " + d.device;
            }
          })
          .catch(() => {});

        btn.addEventListener("click", async () => {
          if (loopbackRunning) {
            await fetch((window._sdrBase || "") + "/api/audio/loopback", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action: "stop" }),
            });
            loopbackRunning = false;
            btn.textContent = "Start";
            btn.style.background = "";
            status.textContent = "Stopped";
          } else {
            const device = parseInt(sel.value);
            localStorage.setItem("loopbackDevice", sel.value);
            const r = await fetch(
              (window._sdrBase || "") + "/api/audio/loopback",
              {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ action: "start", device }),
              },
            );
            const d = await r.json();
            if (d.ok) {
              loopbackRunning = true;
              btn.textContent = "Stop";
              btn.style.background = "#c0392b";
              status.textContent =
                "Running on " +
                (sel.options[sel.selectedIndex]?.text || device);
            } else {
              status.textContent = "Failed";
            }
          }
        });
      })();

      // ── Audio Recording ────────────────────────────────────────────────────────
      (function () {
        const recBtn = document.getElementById("recBtn");
        const recTimer = document.getElementById("recTimer");
        const recDownloadBtn = document.getElementById("recDownloadBtn");
        const recFileList = document.getElementById("recFileList");
