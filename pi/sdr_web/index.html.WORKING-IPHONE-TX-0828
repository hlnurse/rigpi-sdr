      function showFibTargetAt(clientX, clientY) {
        fibLastClientX = clientX;
        fibLastClientY = clientY;
        const rect = fibBar.getBoundingClientRect();
        const ratio = Math.max(
          0,
          Math.min(1, (clientX - rect.left) / Math.max(1, rect.width)),
        );
