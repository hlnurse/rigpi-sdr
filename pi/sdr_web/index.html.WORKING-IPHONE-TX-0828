      function hideFibTooltip(immediate = false) {
        clearTimeout(fibHideTimer);
        if (fibTooltip.hidden) return;
        if (immediate) {
          fibTooltip.classList.remove("fib-closing");
          fibTooltip.hidden = true;
          clearFibInteraction();
          return;
        }

        // Keep the rendered tooltip visible for one frame before beginning
        // the transition. This guarantees a visible fade in Safari as well
        // as Chromium/Firefox, rather than collapsing directly to hidden.
        fibTooltip.classList.remove("fib-closing");
        void fibTooltip.offsetWidth;
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            if (fibTooltip.hidden) return;
            fibTooltip.classList.add("fib-closing");
          });
        });
        fibHideTimer = setTimeout(() => {
          fibTooltip.hidden = true;
          fibTooltip.classList.remove("fib-closing");
          clearFibInteraction();
        }, 540);
      }

      function clearFibInteraction() {
        fibHoverObject = null;
        fibHoverAction = null;
        clearTimeout(fibClearTimer);
        fibTooltip.hidden = true;
        fibHoverRegion.hidden = true;
        fibSnapMarker.hidden = true;
        fibBar.classList.remove("fib-actionable", "fib-raw-target");
        document
          .querySelectorAll("#bandLabel .fib-object-label.fib-hovered")
          .forEach((node) => node.classList.remove("fib-hovered"));
      }

      function setFibHoverVisual(object, ratio, rect) {
        document
          .querySelectorAll("#bandLabel .fib-object-label.fib-hovered")
          .forEach((node) => node.classList.remove("fib-hovered"));

        if (object && fib.viewport) {
          const startRatio = Math.max(
            0,
            (object.start - fib.viewport.f0) / fib.viewport.spanHz,
          );
          const endRatio = Math.min(
            1,
            (object.end - fib.viewport.f0) / fib.viewport.spanHz,
          );
          const left = startRatio * rect.width;
          const right = endRatio * rect.width;
          fibHoverRegion.style.left = `${left}px`;
          fibHoverRegion.style.width = `${Math.max(3, right - left)}px`;
          fibHoverRegion.hidden = false;

          const snapRatio =
            (object.defaultTune - fib.viewport.f0) / fib.viewport.spanHz;
          fibSnapMarker.style.left = `${Math.max(0, Math.min(1, snapRatio)) * rect.width}px`;
          fibSnapMarker.classList.remove("raw");
          fibSnapMarker.hidden = false;

          const labelNode = [
            ...document.querySelectorAll("#bandLabel .fib-object-label"),
          ].find((node) => node.dataset.fibId === object.id);
          if (labelNode) labelNode.classList.add("fib-hovered");
          fibBar.classList.add("fib-actionable");
          fibBar.classList.remove("fib-raw-target");
        } else {
          fibHoverRegion.hidden = true;
          fibSnapMarker.style.left = `${Math.max(0, Math.min(1, ratio)) * rect.width}px`;
          fibSnapMarker.classList.add("raw");
          fibSnapMarker.hidden = false;
          fibBar.classList.remove("fib-actionable");
          fibBar.classList.add("fib-raw-target");
        }
      }

      function previewFibAction(action) {
        if (!action || !fib.viewport || !Number.isFinite(action.frequency))
          return;
        const rect = fibBar.getBoundingClientRect();
        const ratio =
          (action.frequency - fib.viewport.f0) / fib.viewport.spanHz;
        fibSnapMarker.classList.remove("raw");
        if (ratio >= 0 && ratio <= 1) {
          fibSnapMarker.style.left = `${ratio * rect.width}px`;
          fibSnapMarker.hidden = false;
        } else {
          fibSnapMarker.hidden = true;
        }
        fibHoverAction = action;
      }

      function fibBandKey(object) {
        if (!object || object.type !== "ham") return null;
        const match = String(object.shortLabel || object.longLabel || "").match(
          /^(160|80|60|40|30|20|17|15|12|10|6|2|70)\s*(?:m|cm)\b/i,
        );
        return match ? match[1] : null;
      }

      function fibMemoryActions(object) {
        if (!object || object.type !== "ham" || !Array.isArray(memories))
          return [];
        return memories
          .map((memory, slot) => {
            if (!memory || typeof memory !== "object") return null;
            const frequency = Number(memory.freq ?? memory.frequency);
            if (
              !Number.isFinite(frequency) ||
              frequency < object.start ||
              frequency > object.end
            )
              return null;
            const mode = String(memory.mode || "")
              .trim()
              .toUpperCase();
            const bandwidth = Math.max(
              0,
              Math.round(Number(memory.bw ?? memory.bandwidth) || 0),
            );
            return {
              label: String(
                memory.caption ||
                  memory.label ||
                  memory.name ||
                  `Memory ${slot + 1}`,
              ),
              frequency,
              mode,
              bandwidth,
              default: slot === activeMemIdx,
              kind: "panel-memory",
              slot,
              selectionKey: `memory:${slot}`,
            };
          })
          .filter(Boolean);
      }

      function appendFibActionRows(
        container,
        object,
        ratio,
        actions,
        options = {},
      ) {
        const section = document.createElement("div");
        section.className = "fib-action-section";
        if (options.heading) {
          const heading = document.createElement(
            options.onHeadingClick ? "button" : "div",
          );
          heading.className = "fib-action-heading";
          if (options.onHeadingClick) {
            heading.type = "button";
            heading.title = options.headingTitle || "Open panel";
            const headingText = document.createElement("span");
            headingText.textContent = options.heading;
            const hint = document.createElement("span");
            hint.className = "fib-heading-hint";
            hint.textContent = options.headingHint || "click to open";
            heading.append(headingText, hint);
            heading.addEventListener("click", (event) => {
              event.preventDefault();
              event.stopPropagation();
              options.onHeadingClick();
            });
          } else {
            heading.textContent = options.heading;
          }
          section.appendChild(heading);
        }
        if (!actions.length && options.emptyText) {
          const empty = document.createElement("div");
          empty.className = "fib-memory-empty";
          empty.textContent = options.emptyText;
          section.appendChild(empty);
          container.appendChild(section);
          return;
        }
        for (let actionIndex = 0; actionIndex < actions.length; actionIndex++) {
          const fibAction = actions[actionIndex];
          const selectionKey =
            fibAction.selectionKey ||
            `${object?.id || "raw"}:action:${actionIndex}`;
          const isSelected = fibSelectedActionKey === selectionKey;
          const row = document.createElement("button");
          row.type = "button";
          row.className = "fib-action-row";
          row.dataset.frequency = String(fibAction.frequency);
          const marker = document.createElement("span");
          marker.className =
            fibAction.kind === "panel-memory"
              ? "fib-memory-slot"
              : "fib-action-default";
          marker.textContent =
            fibAction.kind === "panel-memory"
              ? `${isSelected ? "●" : "○"} M${fibAction.slot + 1}`
              : isSelected
                ? "●"
                : "○";
          const label = document.createElement("span");
          label.textContent = fibAction.label || "Tune";
          const frequency = document.createElement("span");
          frequency.className = "fib-action-frequency";
