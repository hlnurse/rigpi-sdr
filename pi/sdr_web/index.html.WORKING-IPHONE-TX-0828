      function updateVU() {
        if (!analyser) return;
        if (audioCtx && audioCtx.state === "suspended") {
          audioCtx.resume().catch(() => {});
        }

        const buf = new Uint8Array(analyser.frequencyBinCount);
        analyser.getByteTimeDomainData(buf);

        let sum = 0;

        for (let i = 0; i < buf.length; i++) {
          const v = (buf[i] - 128) / 128;
          sum += v * v;
        }

        const rms = Math.sqrt(sum / buf.length);

        let db = 20 * Math.log10(rms + 1e-6);
        let level = (db + 60) / 60; // map -60..0 dB → 0..1
        level = Math.min(level, 1.2);

        // smoother SDR response
        vuSmooth = vuSmooth * 0.8 + level * 0.2;

        const bar = document.getElementById("vuBar");
        const peak = document.getElementById("vuPeak");
        const clip = document.getElementById("vuClip");

        const pct = Math.min(vuSmooth, 1);
        bar.style.width = pct * 100 + "%";

        if (pct < 0.6) {
          bar.style.background = "#00ff00";
          bar.style.boxShadow = "0 0 6px rgba(0,255,0,0.6)";
        } else if (pct < 0.85) {
