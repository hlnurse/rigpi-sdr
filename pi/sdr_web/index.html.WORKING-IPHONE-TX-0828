                    "</div>"
                  );
                })
                .join("");
              _recUpdatePlayButtons();
            })
            .catch(() => {});
        }

        window._recSelected = null;
        let _recPlayingName = "";
        let _recPlayingKind = "audio";

        function _recPlayer(kind) {
          return kind === "memory"
            ? { audio: memRecPlayback, name: memRecPlaybackName }
            : { audio: recPlayback, name: recPlaybackName };
        }

        function _recUpdatePlayButtons() {
          [recFileList, memRecFileList].forEach((container) => {
            container?.querySelectorAll("[data-rec-play]").forEach((button) => {
              const name = decodeURIComponent(button.dataset.recPlay || "");
              const kind = button.dataset.recPlayer || "audio";
              const player = _recPlayer(kind).audio;
              const playing =
                name === _recPlayingName &&
                kind === _recPlayingKind &&
                player &&
                !player.paused;
              button.textContent = playing ? "❚❚" : "▶";
              button.style.color = playing ? "#f0ad4e" : "#9FE1CB";
            });
          });
        }

        window._recPlay = function (name, kind) {
          kind = kind === "memory" ? "memory" : "audio";
          const selected = _recPlayer(kind);
          const other = _recPlayer(kind === "memory" ? "audio" : "memory");
          if (!selected.audio || !name) return;
          if (
            _recPlayingName === name &&
            _recPlayingKind === kind &&
            selected.audio.src
          ) {
            if (selected.audio.paused) selected.audio.play().catch(() => {});
            else selected.audio.pause();
            return;
          }
          if (other.audio && !other.audio.paused) other.audio.pause();
          _recPlayingName = name;
          _recPlayingKind = kind;
          selected.audio.src =
            (window._sdrBase || "") +
            "/api/audio/recordings/" +
            encodeURIComponent(name);
          selected.audio.style.display = "";
          if (selected.name) selected.name.textContent = name;
          selected.audio.play().catch(() => {});
          _recUpdatePlayButtons();
        };

        recFileList?.addEventListener("click", (event) => {
          const button = event.target.closest("[data-rec-play]");
          if (!button) return;
          event.preventDefault();
          window._recPlay(
            decodeURIComponent(button.dataset.recPlay || ""),
            "audio",
          );
        });
        memRecFileList?.addEventListener("click", (event) => {
          const play = event.target.closest("[data-rec-play]");
          if (play) {
            event.preventDefault();
            window._recPlay(
              decodeURIComponent(play.dataset.recPlay || ""),
              "memory",
            );
            return;
          }
          const download = event.target.closest("[data-rec-download]");
          if (download) {
            event.preventDefault();
            const name = decodeURIComponent(download.dataset.recDownload || "");
            const link = document.createElement("a");
            link.href =
              (window._sdrBase || "") +
              "/api/audio/recordings/" +
              encodeURIComponent(name);
            link.download = name;
            document.body.appendChild(link);
            link.click();
            link.remove();
            return;
          }
          const remove = event.target.closest("[data-rec-delete]");
          if (remove) {
            event.preventDefault();
            window._recDelete(
              decodeURIComponent(remove.dataset.recDelete || ""),
            );
          }
        });
        recPlayback?.addEventListener("play", _recUpdatePlayButtons);
        recPlayback?.addEventListener("pause", _recUpdatePlayButtons);
        recPlayback?.addEventListener("ended", _recUpdatePlayButtons);
        memRecPlayback?.addEventListener("play", _recUpdatePlayButtons);
        memRecPlayback?.addEventListener("pause", _recUpdatePlayButtons);
        memRecPlayback?.addEventListener("ended", _recUpdatePlayButtons);

        window._recSelect = function (name) {
          window._recSelected = name;
          if (recFileList) {
            recFileList
              .querySelectorAll("[data-sel]")
              .forEach((e) => e.removeAttribute("data-sel"));
            var links = recFileList.querySelectorAll("a");
            links.forEach((a) => {
              if (a.download === name) {
                a.style.color = "#9FE1CB";
                a.setAttribute("data-sel", "1");
