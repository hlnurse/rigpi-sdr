    <!-- ═══════════════════════════════════════════════════════════════════════
     3D WATERFALL  (Three.js r128)
     Ring-buffer of FFT rows rendered as a scrolling ribbon surface.
     Each row = one strip of (FFT_COLS-1) quads.
     Color encodes signal strength using the same wfColor() palette.
  ══════════════════════════════════════════════════════════════════════════ -->
    <script src="./three.min.js"></script>
    <script>
      (function () {
        // ── tunables ────────────────────────────────────────────────────────────
        const WF3D_ROWS = 120; // how many time rows to keep
        const WF3D_COLS = 256; // frequency resolution (downsampled from FFT)
        const WF3D_DEPTH = 6.0; // Z extent of the ribbon (time axis)
        const WF3D_WIDTH = 10.0; // X extent (frequency axis)
        const WF3D_HEIGHT = 1.8; // Y scale for signal peaks
        const WF3D_FPS = 30;

        // ── state ────────────────────────────────────────────────────────────────
        const wf3dVisibilityKey =
          "rigpiWf3dVisible:" +
          (window._sdrBase || "") +
          ":" +
          (window._sdrUser || "admin");
        let wf3dActive = false;
        try {
          wf3dActive = localStorage.getItem(wf3dVisibilityKey) === "1";
        } catch (_storageError) {}
        let wf3dInited = false;
        let renderer, scene, camera, ribbon, animId;
        let bgScene, bgCam;
        let rowHead = 0; // ring-buffer write pointer
        let rowCount = 0; // rows filled so far
        // Ring buffer: Float32Array[WF3D_ROWS][WF3D_COLS]  magnitude 0..1
        const rowBuf = new Float32Array(WF3D_ROWS * WF3D_COLS);

        // Orbit state
        let orbitAzimuth = -0.35; // radians
        let orbitElevation = 0.42;
        let orbitRadius = 12.0;
        let orbitDragging = false;
        let orbitLast = { x: 0, y: 0 };

        const btn3d = document.getElementById("wf3dBtn");
        const wf3dCvs = document.getElementById("wf3dCanvas");
        const wfCvs = document.getElementById("wfCanvas");

        function applyWf3dMode() {
          btn3d.classList.toggle("active", wf3dActive);
          if (window._mapModeActive) {
            wf3dCvs.style.display = "none";
            stopWf3d();
            return;
          }
          wf3dCvs.style.display = wf3dActive ? "block" : "none";
          wfCvs.style.display = wf3dActive ? "none" : "block";
