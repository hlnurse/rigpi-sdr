            if (!matched) {
              for (const opt of sel.options) {
                try {
                  const v = JSON.parse(opt.value);
                  if (!v.port && v.driver !== "fake" && !opt.disabled) {
                    opt.selected = true;
                    break;
                  }
                } catch {}
              }
            }
          })
          .catch(() => {
            if (buildGeneration === window._deviceDropdownBuildGeneration) {
              lastDeviceList = "";
            }
          });
        // placeholder — actual rendering done after instances fetch above
        if (false)
          d.available_devices.forEach((dev) => {
            const opt = document.createElement("option");
            opt.value = JSON.stringify({
              driver: dev.driver,
              serial: dev.serial || "",
              remote: dev.remote || "",
            });
            const base = dev.label || dev.driver || "SDR";
            opt.textContent =
              labelTotals[base] > 1 && dev.serial
                ? `${base} (${dev.serial})`
                : base;
            const isActive =
              dev.driver === _activeDeviceDriver &&
              (dev.serial || "") === _activeDeviceSerial &&
              (dev.remote || "") === (_activeDeviceRemote || "");
            opt.selected = isActive;
            // If this is the active device, force it selected via sel.value too
            if (isActive) sel.value = opt.value;
            sel.appendChild(opt);
          });
        // Force correct selection immediately after building local options
        let matched = false;
        for (const opt of sel.options) {
          try {
            const v = JSON.parse(opt.value);
            if (
              !v.port &&
              v.driver === _activeDeviceDriver &&
              (v.serial || "") === _activeDeviceSerial
            ) {
              opt.selected = true;
              matched = true;
              break;
            }
          } catch {}
        }
        if (!matched) {
          for (const opt of sel.options) {
            try {
              const v = JSON.parse(opt.value);
              if (!v.port && v.driver !== "fake") {
                opt.selected = true;
                break;
              }
            } catch {}
          }
        }

        // Guarantee KiwiSDR option appears even if fetch is slow —
        // but only once real devices are present, so this can't become
        // the sole/auto-selected option during early startup before
        // AirSpy (or other local hardware) has finished enumerating.
        setTimeout(function () {
          const hasRealDevices = Array.from(sel.options).some((o) => {
            try {
              return !!JSON.parse(o.value).driver;
            } catch {
              return false;
            }
          });
          if (
            hasRealDevices &&
            !sel.querySelector('option[value="__kiwi__"]')
          ) {
            const kiwiOpt = document.createElement("option");
            kiwiOpt.value = "__kiwi__";
            kiwiOpt.textContent = "── Remote SDR...";
            kiwiOpt.style.color = "#38bdf8";
            sel.appendChild(kiwiOpt);
          }
        }, 1000);
