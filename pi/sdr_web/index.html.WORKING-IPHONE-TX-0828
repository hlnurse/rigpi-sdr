              const base = dev.label || dev.driver || "SDR";
              const takenBy =
                inUseByOther[
                  dev.serial ? dev.serial : dev.driver.toLowerCase()
                ];
              opt.value = JSON.stringify({
                driver: dev.driver,
                serial: dev.serial || "",
                remote: dev.remote || "",
              });
              opt.textContent = takenBy
                ? `${base} (in use by ${takenBy})`
                : labelTotals[base] > 1 && dev.serial
                  ? `${base} (${dev.serial})`
                  : base;
              opt.style.color = takenBy ? "#555" : "";
              opt.disabled = !!takenBy;
              const isActive =
                dev.driver === _activeDeviceDriver &&
                (dev.serial || "") === _activeDeviceSerial;
              opt.selected = isActive && !takenBy;
              sel.insertBefore(opt, sel.firstChild);
