      async function resolveSpotLatLon(spots) {
        const missing = spots.filter(function (s) {
          return (!parseFloat(s.Latitude) || !parseFloat(s.Longitude)) && s.DX;
        });
        // First try grid square lookup (fast, no server call)
        missing.forEach(function (s) {
          if (s.DXGrid && s.DXGrid.length >= 4 && window._grid2latlon) {
            const ll = window._grid2latlon(s.DXGrid);
            if (ll) {
              s.Latitude = ll.lat;
              s.Longitude = ll.lon;
            }
          }
        });
        // Then try prefix lookup for remaining spots without lat/lon
        const stillMissing = missing.filter(function (s) {
          return !parseFloat(s.Latitude) || !parseFloat(s.Longitude);
        });
        for (const s of stillMissing) {
          if (window._callLatLonCache[s.DX] !== undefined) {
            s.Latitude = window._callLatLonCache[s.DX].lat;
            s.Longitude = window._callLatLonCache[s.DX].lon;
          } else {
            try {
              const r = await fetch(
                (window._sdrBase || "") +
                  "/api/call_latlon?call=" +
                  encodeURIComponent(s.DX),
              );
              const d = await r.json();
              if (d.ok) {
                window._callLatLonCache[s.DX] = { lat: d.lat, lon: d.lon };
                s.Latitude = d.lat;
                s.Longitude = d.lon;
              } else {
                window._callLatLonCache[s.DX] = { lat: null, lon: null };
              }
            } catch (e) {}
          }
        }
        return spots;
      }
