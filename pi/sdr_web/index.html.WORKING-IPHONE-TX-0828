      let audioRunning = false;
      // ---- One-minute live broadcast translation ----
      const liveCaptionButton = document.getElementById("liveCaptionButton");
      const liveCaptionLanguage = document.getElementById(
        "liveCaptionLanguage",
      );
      const liveCaptionTimer = document.getElementById("liveCaptionTimer");
      const liveCaptionText = document.getElementById("liveCaptionText");
      const liveCaptionViewport = document.getElementById(
        "liveCaptionViewport",
      );
      let liveCaptionActive = false;
      let liveCaptionCancelled = false;
      let liveCaptionExpiresAt = 0;
      let liveCaptionSessionId = "";
      let liveCaptionSequence = 0;
      let liveCaptionLastShown = 0;
      let liveCaptionCountdown = null;
      let liveCaptionRecorder = null;
      let liveCaptionStopTimer = null;
      let liveCaptionFadeTimer = null;
      let liveCaptionSourceLanguage = "";

      function liveCaptionMessage(text, dim) {
        clearTimeout(liveCaptionFadeTimer);
        liveCaptionText.classList.remove("scrolling");
        liveCaptionText.classList.toggle("dim", !!dim);
        liveCaptionText.style.removeProperty("--caption-travel");
        liveCaptionText.style.removeProperty("--caption-scroll-time");
        liveCaptionText.textContent = text;
        requestAnimationFrame(() => {
          const travel = Math.max(
            0,
            liveCaptionText.scrollWidth - liveCaptionViewport.clientWidth,
          );
          if (travel > 8 && !dim) {
            liveCaptionText.style.setProperty(
              "--caption-travel",
              `-${travel}px`,
            );
            liveCaptionText.style.setProperty(
              "--caption-scroll-time",
              `${Math.max(7, travel / 28)}s`,
            );
            liveCaptionText.classList.add("scrolling");
          }
        });
        if (!dim) {
          liveCaptionFadeTimer = setTimeout(() => {
            liveCaptionText.classList.remove("scrolling");
            liveCaptionText.classList.add("dim");
            liveCaptionText.textContent = liveCaptionActive
              ? "Listening…"
              : "Continue for another minute?";
          }, 5000);
        }
      }

      function liveCaptionFormatTime(seconds) {
        seconds = Math.max(0, Math.ceil(seconds));
        return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`;
      }

      function liveCaptionFinish(expired, message) {
        liveCaptionActive = false;
        clearInterval(liveCaptionCountdown);
        liveCaptionCountdown = null;
        liveCaptionTimer.textContent = expired ? "0:00" : "";
        liveCaptionButton.classList.remove("active");
        liveCaptionButton.textContent = expired
          ? "Continue 1 min"
          : "Translate";
        if (message) liveCaptionMessage(message, true);
        else if (expired)
          liveCaptionMessage(
            "Minute complete — continue when you want more",
            true,
          );
      }

      function liveCaptionMimeType() {
        const candidates = [
          "audio/webm;codecs=opus",
          "audio/mp4;codecs=mp4a.40.2",
          "audio/mp4",
          "audio/ogg;codecs=opus",
        ];
        return (
          candidates.find(
            (type) =>
              !MediaRecorder.isTypeSupported ||
              MediaRecorder.isTypeSupported(type),
          ) || ""
        );
      }

      async function liveCaptionBlobBase64(blob) {
        const bytes = new Uint8Array(await blob.arrayBuffer());
        let binary = "";
        for (let offset = 0; offset < bytes.length; offset += 32768) {
          binary += String.fromCharCode(
            ...bytes.subarray(offset, offset + 32768),
          );
        }
        return btoa(binary);
      }

      function liveCaptionRecordChunk(milliseconds) {
        return new Promise((resolve, reject) => {
          if (!audioCtx || !analyser) {
            reject(new Error("Start receiver audio first."));
            return;
          }
          const destination = audioCtx.createMediaStreamDestination();
          const mimeType = liveCaptionMimeType();
          let peakRms = 0;
          let levelTimer = null;
          try {
            analyser.connect(destination);
            const options = mimeType ? { mimeType } : undefined;
            const recorder = new MediaRecorder(destination.stream, options);
            liveCaptionRecorder = recorder;
            const chunks = [];
            recorder.ondataavailable = (event) => {
              if (event.data && event.data.size) chunks.push(event.data);
            };
            recorder.onerror = (event) =>
              reject(
                event.error || new Error("Unable to capture receiver audio."),
              );
            recorder.onstop = () => {
              clearInterval(levelTimer);
              clearTimeout(liveCaptionStopTimer);
              try {
                analyser.disconnect(destination);
              } catch (_error) {}
              if (liveCaptionRecorder === recorder) liveCaptionRecorder = null;
              resolve({
                blob: new Blob(chunks, {
                  type: recorder.mimeType || mimeType || "audio/webm",
                }),
                peakRms,
              });
            };
            const samples = new Uint8Array(analyser.fftSize);
            levelTimer = setInterval(() => {
              analyser.getByteTimeDomainData(samples);
              let sum = 0;
              for (const sample of samples) {
                const value = (sample - 128) / 128;
                sum += value * value;
              }
              peakRms = Math.max(peakRms, Math.sqrt(sum / samples.length));
            }, 200);
            recorder.start();
            liveCaptionStopTimer = setTimeout(() => {
              if (recorder.state !== "inactive") recorder.stop();
            }, milliseconds);
          } catch (error) {
            clearInterval(levelTimer);
            try {
              analyser.disconnect(destination);
            } catch (_error) {}
            reject(error);
          }
        });
      }

      async function liveCaptionSend(
        blob,
        durationSeconds,
        sequence,
        frequencyHz,
      ) {
        if (blob.size < 256) return;
        const response = await fetch("/elmer-api/translation", {
          method: "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            session_id: liveCaptionSessionId,
            sequence,
            detect_language: !liveCaptionSourceLanguage,
            duration_seconds: durationSeconds,
            media_type: String(blob.type || "audio/webm").split(";", 1)[0],
            audio_base64: await liveCaptionBlobBase64(blob),
          }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok)
          throw new Error(
            data.error || "Broadcast translation is unavailable.",
          );
        if (
          sequence < liveCaptionLastShown ||
          frequencyHz !== Math.round(Number(currentTunedFrequency()))
        )
          return;
        const detectedLanguage = String(data.language || "").trim();
        if (detectedLanguage && liveCaptionLanguage) {
          liveCaptionSourceLanguage = detectedLanguage;
          const source =
            detectedLanguage.charAt(0).toUpperCase() +
            detectedLanguage.slice(1);
          liveCaptionLanguage.textContent = `${source} → English`;
          liveCaptionLanguage.title = `Translating ${source} speech to English`;
        }
        const text = String(data.text || "").trim();
        if (text) {
          liveCaptionLastShown = sequence;
          liveCaptionMessage(text, false);
        }
      }

      async function liveCaptionLoop() {
        try {
          while (liveCaptionActive) {
            const remainingMs = liveCaptionExpiresAt - Date.now();
            if (remainingMs <= 0) break;
            const durationMs = Math.min(5000, Math.max(500, remainingMs));
            const frequencyHz = Math.round(Number(currentTunedFrequency()));
            const result = await liveCaptionRecordChunk(durationMs);
            if (liveCaptionCancelled) return;
            const sequence = ++liveCaptionSequence;
            // A very low RMS is dead air. Broadcast noise/speech easily exceeds this.
            if (result.peakRms >= 0.0045) {
              liveCaptionSend(
                result.blob,
                durationMs / 1000,
                sequence,
                frequencyHz,
              ).catch((error) => {
                if (liveCaptionActive) {
                  liveCaptionCancelled = true;
                  liveCaptionFinish(false, error.message);
                }
              });
            }
          }
          if (!liveCaptionCancelled) liveCaptionFinish(true);
        } catch (error) {
          liveCaptionFinish(false, error.message);
        }
      }

      async function liveCaptionStart() {
        if (liveCaptionActive) return;
        liveCaptionCancelled = false;
        if (!audioRunning) {
          if (!audioCtx) audioCtx = new AudioContext();
          if (audioCtx.state !== "running") await audioCtx.resume();
          await startAudioFromUserGesture();
          audioRunning = true;
          audioMuted = false;
          setAudioLed(true);
          setAudioButtonUI();
        }
        for (let attempt = 0; !analyser && attempt < 20; attempt++) {
          await new Promise((resolve) => setTimeout(resolve, 100));
        }
        if (!analyser) throw new Error("Receiver audio has not connected yet.");
        liveCaptionSessionId = (
          crypto.randomUUID
            ? crypto.randomUUID()
            : `caption_${Date.now()}_${Math.random().toString(36).slice(2)}`
        ).replaceAll("-", "_");
        liveCaptionSequence = 0;
        liveCaptionLastShown = 0;
        liveCaptionSourceLanguage = "";
        liveCaptionExpiresAt = Date.now() + 60000;
        liveCaptionActive = true;
        liveCaptionButton.classList.add("active");
        liveCaptionButton.textContent = "Stop";
        if (liveCaptionLanguage) {
          liveCaptionLanguage.textContent = "Detecting…";
          liveCaptionLanguage.title = "Detecting the broadcast language";
        }
        liveCaptionMessage("Listening for speech…", true);
        const updateCountdown = () => {
          liveCaptionTimer.textContent = liveCaptionFormatTime(
            (liveCaptionExpiresAt - Date.now()) / 1000,
          );
        };
        updateCountdown();
        liveCaptionCountdown = setInterval(updateCountdown, 250);
        liveCaptionLoop();
      }

      liveCaptionButton?.addEventListener("click", async () => {
        if (liveCaptionActive) {
          liveCaptionCancelled = true;
          if (liveCaptionRecorder && liveCaptionRecorder.state !== "inactive")
            liveCaptionRecorder.stop();
          liveCaptionFinish(false, "Broadcast translation stopped");
          return;
        }
        liveCaptionButton.disabled = true;
        try {
          await liveCaptionStart();
        } catch (error) {
          liveCaptionFinish(false, error.message);
        } finally {
          liveCaptionButton.disabled = false;
        }
      });

