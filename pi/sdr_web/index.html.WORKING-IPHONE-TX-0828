          e.preventDefault();
          spCanvas.setPointerCapture(e.pointerId);
          bwDragging = true;
          _bwDragEdge = edge;
          const edges = _bwEdgeXsCss();
          _bwAnchorHz = edge === "right" ? edges.leftHz : edges.rightHz;
        } else {
          // Center freq drag — only if near the orange center line
          const rect2 = spCanvas.getBoundingClientRect();
          const centerX = rect2.width / 2;
          if (Math.abs(xCss - centerX) < 8) {
