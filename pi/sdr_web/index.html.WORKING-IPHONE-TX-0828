        fibShiftHeld = false;
        fibLastShiftWheelAt = 0;
        fibWheelTuneHz = NaN;
      });

      function currentTunedFrequency() {
        const candidates = [
          state._exactFreq,
          state.tuned_freq,
          window._sdrLastState && window._sdrLastState.rig_freq,
          window._sdrLastState && window._sdrLastState.owrx_freq,
          state.center_freq,
        ];
        for (const value of candidates) {
          const hz = Number(value);
          if (Number.isFinite(hz) && hz > 0) return Math.round(hz);
        }
        return NaN;
      }

      function signedWheelDirection(event) {
        // Use the browser-standard signed deltas only. Do not use wheelDeltaY:
        // Safari can report a stale/constant legacy sign during Shift scrolling.
        const dy = Number(event.deltaY);
        if (Number.isFinite(dy) && Math.abs(dy) > 0.01) return dy < 0 ? 1 : -1;
        const dx = Number(event.deltaX);
        if (Number.isFinite(dx) && Math.abs(dx) > 0.01) return dx < 0 ? 1 : -1;
        return 0;
      }

      function handleFibWheel(event) {
        event.preventDefault();
        event.stopImmediatePropagation();

        const now = performance.now();
        const shiftNow =
          fibShiftHeld ||
          event.shiftKey ||
          (typeof event.getModifierState === "function" &&
            event.getModifierState("Shift"));
        const direction = signedWheelDirection(event);
        if (!direction) return;

        if (shiftNow) {
          fibLastShiftWheelAt = now;
          if (!Number.isFinite(fibWheelTuneHz))
            fibWheelTuneHz = currentTunedFrequency();
          if (!Number.isFinite(fibWheelTuneHz)) return;

          fibWheelTuneHz = Math.max(
            0,
            Math.round(fibWheelTuneHz + direction * selectedLedFrequencyStep()),
          );
          freqEditHold = Date.now() + 5000;
          state.tuned_freq = fibWheelTuneHz;
          state._exactFreq = fibWheelTuneHz;
          renderFreqLED(fibWheelTuneHz);
          sendTune(fibWheelTuneHz);
          if (
            lastDisplay &&
            Array.isArray(lastDisplay.freqs) &&
            lastDisplay.freqs.length > 1
          ) {
            renderFreqScale(lastDisplay.freqs);
          }
          syncFibSelectionFromState();
          return;
        }

        // macOS may emit momentum events with shiftKey=false after a Shift-wheel
        // event. Never turn those events into bandwidth changes. A deliberate
        // plain-wheel BW gesture can begin after the stream has been quiet.
        if (now - fibLastShiftWheelAt < 1200) return;

        fibWheelTuneHz = NaN;
        const step = fibBandwidthStep(state.mode);
        const nextBandwidth = Math.max(
          step,
          Math.round(Number(state.bw) || getDefaultBW(state.mode || "USB")) +
            direction * step,
        );
        state.bw = nextBandwidth;
        modeEditing = true;
        modeBwHoldUntil = Date.now() + 4000;
        updateModeBW();
        sendControl({ mode: state.mode, bw: nextBandwidth });
        setTimeout(() => {
          if (Date.now() >= modeBwHoldUntil) modeEditing = false;
        }, 4100);
      }

      fibBar.addEventListener("wheel", handleFibWheel, { passive: false });
      fibTooltip.addEventListener("wheel", handleFibWheel, { passive: false });

      fibBar.addEventListener("pointerdown", (event) => {
        if (event.button !== 0) return;
        fibPointerGesture = {
          pointerId: event.pointerId,
          pointerType: event.pointerType,
          startX: event.clientX,
          startY: event.clientY,
          moved: false,
        };
        if (event.pointerType !== "mouse") {
          showFibTargetAt(event.clientX, event.clientY);
        }
      });

      fibBar.addEventListener("pointermove", (event) => {
        if (
          !fibPointerGesture ||
          event.pointerId !== fibPointerGesture.pointerId
        )
          return;
        const dx = event.clientX - fibPointerGesture.startX;
        const dy = event.clientY - fibPointerGesture.startY;
        if (Math.hypot(dx, dy) > FIB_DRAG_CANCEL_PX)
          fibPointerGesture.moved = true;
        if (event.pointerType !== "mouse" && !fibPointerGesture.moved) {
          showFibTargetAt(event.clientX, event.clientY);
        }
      });

      fibBar.addEventListener("pointerup", (event) => {
        const gesture = fibPointerGesture;
        fibPointerGesture = null;
        if (!gesture || event.pointerId !== gesture.pointerId) return;
        if (gesture.moved) {
          fibSuppressClickUntil = performance.now() + 500;
          clearFibInteraction();
          return;
        }
        if (event.pointerType !== "mouse") {
          const result = showFibTargetAt(event.clientX, event.clientY);
          tuneFibTarget(result.object, result.ratio);
