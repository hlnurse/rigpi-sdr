      fibBar.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          event.preventDefault();
          hideFibTooltip(true);
          return;
        }
        const objects = keyboardFibObjects();
        if (!objects.length) return;
        if (
          ["ArrowLeft", "ArrowRight", "Home", "End", "Enter", " "].includes(
            event.key,
          )
        )
          event.preventDefault();
        if (event.key === "Home") fibKeyboardIndex = 0;
        else if (event.key === "End") fibKeyboardIndex = objects.length - 1;
        else if (event.key === "ArrowRight")
          fibKeyboardIndex = Math.min(
            objects.length - 1,
            fibKeyboardIndex < 0 ? 0 : fibKeyboardIndex + 1,
          );
        else if (event.key === "ArrowLeft")
          fibKeyboardIndex = Math.max(
            0,
            fibKeyboardIndex < 0 ? objects.length - 1 : fibKeyboardIndex - 1,
          );
        else if (event.key === "Enter" || event.key === " ") {
          const object = objects[Math.max(0, fibKeyboardIndex)];
          if (object) tuneFibTarget(object, 0);
          return;
