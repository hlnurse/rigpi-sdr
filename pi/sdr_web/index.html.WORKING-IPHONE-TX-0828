      async function refreshFibSchedules() {
        if (Array.isArray(lastDisplay?.freqs) && lastDisplay.freqs.length > 1) {
          const low = Math.round(
            Math.min(lastDisplay.freqs[0], lastDisplay.freqs.at(-1)),
          );
          const high = Math.round(
            Math.max(lastDisplay.freqs[0], lastDisplay.freqs.at(-1)),
          );
          fibScheduleProvider.url =
            (window._sdrBase || "") +
            `/api/shortwave/schedule?low_hz=${low}&high_hz=${high}`;
        }
        fibScheduleProvider.loaded = false;
        fibScheduleProvider.loading = null;
        try {
          await fibScheduleProvider.load();
          fib.objects = fib.providers
            .flatMap((provider) => provider.getObjects())
            .filter(Boolean);
          fib.rebuildVisibleObjects();
          if (Array.isArray(lastDisplay?.freqs) && lastDisplay.freqs.length > 1)
            renderFreqScale(lastDisplay.freqs);
        } catch (error) {
          console.warn("FIB schedule refresh:", error);
        }
      }
      function queueFibScheduleRefresh(freqsDisplay) {
        if (!Array.isArray(freqsDisplay) || freqsDisplay.length < 2) return;
        const low = Math.round(
          Math.min(freqsDisplay[0], freqsDisplay.at(-1)) / 10000,
        );
        const high = Math.round(
          Math.max(freqsDisplay[0], freqsDisplay.at(-1)) / 10000,
        );
        const rangeKey = `${low}:${high}`;
        if (rangeKey === fibScheduleRangeKey) return;
        fibScheduleRangeKey = rangeKey;
        clearTimeout(fibScheduleRefreshTimer);
        fibScheduleRefreshTimer = window.setTimeout(refreshFibSchedules, 500);
      }
      window.setInterval(refreshFibSchedules, 60_000);

