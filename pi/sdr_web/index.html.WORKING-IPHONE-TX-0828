              const serial =
                typeof taken === "object" && taken ? taken.serial : "";
              const owner =
                typeof taken === "object" && taken && taken.port
                  ? "port " + taken.port
                  : "another instance";
              if (serial) inUseByOther[serial] = owner;
              if (drv) inUseByOther[drv.toLowerCase()] = owner;
            });

            // Rebuild local device options with in-use info
            // First remove existing local device options (non-port entries)
            Array.from(sel.options).forEach((opt) => {
              try {
                const v = JSON.parse(opt.value);
