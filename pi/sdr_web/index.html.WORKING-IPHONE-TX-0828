                    '<div style="display:flex;gap:4px;align-items:center;margin-bottom:2px;">' +
                    '<button data-rec-play="' +
                    encodeURIComponent(f.name) +
                    '" title="Play/pause" style="font-size:9px;padding:0 4px;height:16px;min-width:22px;background:#081808;color:#9FE1CB;border:1px solid #2a4a2a;border-radius:2px;cursor:pointer;">▶</button>' +
                    '<a href="' +
                    (window._sdrBase || "") +
                    "/api/audio/recordings/" +
                    encodeURIComponent(f.name) +
                    '" download="' +
                    f.name +
                    '" style="color:#4af;font-size:10px;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="' +
                    f.name +
                    '">' +
                    f.name +
                    "</a>" +
                    '<span style="color:#666;font-size:9px;white-space:nowrap;">' +
                    f.size +
                    "</span>" +
                    "<button onclick=\"window._recDelete('" +
