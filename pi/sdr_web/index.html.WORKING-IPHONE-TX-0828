            .map(function (f) {
              const encodedName = encodeURIComponent(f.name);
              const safeName = _recEscape(f.name);
              const safeSize = _recEscape(f.size);
              return (
                '<div style="display:flex;gap:4px;align-items:center;margin-bottom:2px;min-width:0;">' +
                '<button data-rec-play="' +
