          var actEl = document.getElementById("wiActivity");
          if (actEl && actEl.textContent)
            allLines.push("\nDXSummit: " + actEl.textContent);

          if (logData.awards && logData.awards.length > 0) {
            allLines.push("\nAWARDS:");
            logData.awards.forEach(function (a) {
              allLines.push("  " + a);
            });
          }
          if (bulletin) {
            var bwords = bulletin.split(" ");
            var bline = "";
            var bwrapped = "";
            bwords.forEach(function (w) {
              if ((bline + " " + w).trim().length > 78) {
                bwrapped += bline.trim() + "\n";
                bline = w;
              } else {
                bline += (bline ? " " : "") + w;
              }
            });
            if (bline) bwrapped += bline.trim();
            allLines.push("\nARRL DX Bulletin:\n" + bwrapped);
          }
          if (psk) allLines.push("PSKReporter: " + psk);
          allLines.push(ts);
          window._wiLastPlainText = allLines.filter(Boolean).join("\n");
          var text = allLines.filter(Boolean).join("\n");
          var title = "ELMER Workability Index \u2014 " + call;
          var _esc = function (s) {
            return s
              .replace(/&/g, "&amp;")
              .replace(/</g, "&lt;")
              .replace(/>/g, "&gt;");
          };
          var htmlText =
            '<div style="font-family:Courier New,Courier,monospace;font-size:13px;line-height:1.6;font-weight:normal;">' +
            '<div style="text-align:center;font-weight:bold;margin-bottom:4px;">' +
            _esc(title) +
            "</div>" +
            '<div style="white-space:pre;font-weight:normal;text-align:left;">' +
            _esc(allLines.filter(Boolean).join("\n")) +
            "</div>" +
            "</div>";
          if (
            navigator.clipboard &&
            navigator.clipboard.write &&
            window.ClipboardItem
          ) {
            try {
              var item = new ClipboardItem({
                "text/html": new Blob([htmlText], { type: "text/html" }),
                "text/plain": new Blob([text], { type: "text/plain" }),
              });
              navigator.clipboard
                .write([item])
                .then(function () {
                  var btn = document.getElementById("wiCopyBtn");
                  if (btn) {
                    btn.textContent = "✓ Copied";
                    setTimeout(function () {
                      btn.textContent = "⎘ Copy";
                    }, 2000);
                  }
                })
                .catch(function () {
                  _wiCopyPlain(text);
                });
            } catch (e) {
              _wiCopyPlain(text);
            }
          } else {
            _wiCopyPlain(text);
          }
        };
        window._wiSendReport = async function (extBtn) {
          var call = document.getElementById("wiModalCall")
            ? document.getElementById("wiModalCall").textContent
            : "";
          var email = document.getElementById("wiQRZEmail")
            ? document.getElementById("wiQRZEmail").textContent
            : "";
          var name = document.getElementById("wiQRZName")
            ? document.getElementById("wiQRZName").textContent
            : "";
          if (!email) {
            alert("No email address on file for " + call);
            if (extBtn) {
              extBtn.textContent = "No email";
              extBtn.disabled = false;
            }
            return;
          }
          var btn = document.getElementById("wiSendBtn");
          if (btn) {
            btn.textContent = "Sending...";
            btn.disabled = true;
          }
          if (typeof window._wiViewFormatted === "function")
            await window._wiViewFormatted(true);
          var report =
            (window._wiLastHTML || "").replace(
              /<!--SEND_BTN-->[\s\S]*?<!--\/SEND_BTN-->/,
              "",
            ) ||
            window._wiLastPlainText ||
            "";
          fetch((window._sdrBase || "") + "/api/send_wi_report", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              email: email,
              call: call,
              name: name,
              report: report,
              user: window._sdrCallsign || "",
              recording: window._recFilename || _recFilename || "",
            }),
          })
            .then(function (r) {
              return r.json();
            })
            .then(function (d) {
              if (btn) {
                btn.textContent = d.ok ? "✓ Sent" : "✗ Failed";
                btn.disabled = false;
                setTimeout(function () {
                  btn.textContent = "✉ Send Report";
                }, 3000);
              }
              if (extBtn) {
                extBtn.textContent = d.ok ? "✓ Sent!" : "✗ Failed";
                extBtn.disabled = false;
              }
            })
            .catch(function () {
              if (btn) {
                btn.textContent = "✗ Failed";
                btn.disabled = false;
                setTimeout(function () {
                  btn.textContent = "✉ Send Report";
                }, 3000);
              }
              if (extBtn) {
                extBtn.textContent = "✗ Failed";
                extBtn.disabled = false;
              }
            });
        };
        window.elmrTune = function (
          hz,
          dx,
          dxGrid,
          spotCount,
          dxBearing,
          spotMode,
        ) {
          if (typeof sendTune === "function") {
            sendTune(hz);
          } else {
            fetch((window._sdrBase || "") + "/api/tune", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                freq: hz,
                callsign: window._sdrCallsign || "",
                radio: window._sdrRadio || 1,
              }),
            }).catch(() => {});
          }
          if (spotMode) {
            // SDR demod side (existing): sets the waterfall/audio demod mode.
            const _modeMap = {
              CW: "CW",
              SSB: "USB",
              USB: "USB",
              LSB: "LSB",
              FT8: "PKTUSB",
              FT4: "PKTUSB",
              RTTY: "USB",
              AM: "AM",
              FM: "NFM",
              DIG: "USB",
              PSK: "USB",
            };
            const _bwMap = {
              CW: 500,
              SSB: 2700,
              USB: 2700,
              LSB: 2700,
              FT8: 3000,
              FT4: 3000,
              RTTY: 2700,
              AM: 6000,
              FM: 10000,
              NFM: 10000,
              DIG: 2700,
              PSK: 2700,
            };
            const _mu = spotMode.toUpperCase();
            const _m = _modeMap[_mu] || _mu;
            const _bw = _bwMap[_mu] || 2700;
            fetch((window._sdrBase || "") + "/api/control", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                mode: _m,
                bw: _bw,
                user: window._sdrUser || "admin",
              }),
            }).catch(() => {});
            // Physical rig side (new): also set the RADIO's mode so it follows
            // the spot, not just the SDR. Rig mode names differ from demod names
            // (FT8 -> PKTUSB, etc.). Routed through /api/tune -> rigctl_handler,
            // the same path the frequency uses. Sent shortly after the tune so
            // the frequency lands first (mirrors the flic freq-then-mode order).
            const _rigModeMap = {
              CW: "CW",
              SSB: "USB",
              USB: "USB",
              LSB: "LSB",
              FT8: "PKTUSB",
              FT4: "PKTUSB",
              RTTY: "RTTY",
              AM: "AM",
              FM: "FM",
              NFM: "FM",
              DIG: "PKTUSB",
              PSK: "PKTUSB",
            };
            const _rigBwMap = {
              CW: 500,
              SSB: 2700,
              USB: 2700,
              LSB: 2700,
              FT8: 3000,
              FT4: 3000,
              RTTY: 2700,
              AM: 6000,
              FM: 12000,
              NFM: 12000,
              DIG: 2700,
              PSK: 2700,
            };
            const _rm = _rigModeMap[_mu] || "USB";
            const _rbw = _rigBwMap[_mu] || 2700;
            setTimeout(function () {
              fetch((window._sdrBase || "") + "/api/tune", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  freq: hz,
                  mode: _rm,
                  bw: _rbw,
                  callsign: window._sdrCallsign || "",
                  radio: window._sdrRadio || 1,
                  user: window._sdrUser || "admin",
                  slice_only: true,
                }),
              }).catch(() => {});
            }, 1000);
          }
          // Set DX call in header search box
          if (dx) {
            dx = dx.toUpperCase();
            // Send to parent via postMessage (cross-origin safe)
            window.parent.postMessage({ type: "elmrTune", dx: dx }, "*");
            // Local fallback
            const localBox = document.getElementById("searchText");
            if (localBox) localBox.value = dx;
            // Show workability section
            if (typeof window._elmrShowWI === "function") {
              window._elmrShowWI(dx, dxGrid || "", spotCount || 0, dxBearing);
            }
            // Store frequency for signal check
            window._elmrWIFreq = hz;
            var sigBtn = document.getElementById("elmrWISigBtn");
            if (sigBtn) sigBtn.style.display = "";
            var sigStatus = document.getElementById("elmrWISigStatus");
            if (sigStatus) {
              sigStatus.textContent = "";
            }
            // Store frequency for signal check
            window._elmrWIFreq = hz;
            var sigBtn = document.getElementById("elmrWISigBtn");
            if (sigBtn) sigBtn.style.display = "";
            var sigStatus = document.getElementById("elmrWISigStatus");
            if (sigStatus) {
              sigStatus.textContent = "";
            }
          }
        };
        function elmrStart() {
          elmrStop();
          elmrSnap();
          elmrFetchSpots();
          elmrTimer = setInterval(elmrSnap, 600);
          elmrSpotsTimer = setInterval(elmrFetchSpots, 10000);
        }
        function elmrStop() {
          if (elmrTimer) {
            clearInterval(elmrTimer);
            elmrTimer = null;
          }
          if (elmrSpotsTimer) {
            clearInterval(elmrSpotsTimer);
            elmrSpotsTimer = null;
          }
        }

        if (elmrVisible) elmrStart();
      })();
      // ===== END ELMER =====
    </script>
