      // Ring buffer (Float32)
      const RING_SECONDS = 6.0; // enough to absorb jitter
      const RING_SAMPLES = Math.floor(AUDIO_SR * RING_SECONDS);
      const ring = new Float32Array(RING_SAMPLES);
      let wptr = 0,
        rptr = 0,
        count = 0;

      function rbWrite(src) {
        // src: Float32Array
        if (!src || src.length === 0) return;

        // If overflow, drop oldest to make room
        if (src.length > RING_SAMPLES) {
          src = src.subarray(src.length - RING_SAMPLES);
        }
        let needed = src.length;
        let free = RING_SAMPLES - count;
        if (needed > free) {
          const drop = needed - free;
          rptr = (rptr + drop) % RING_SAMPLES;
          count -= drop;
          if (count < 0) count = 0;
        }

        // Write with wrap
        let n1 = Math.min(needed, RING_SAMPLES - wptr);
        ring.set(src.subarray(0, n1), wptr);
        if (needed > n1) ring.set(src.subarray(n1), 0);

        wptr = (wptr + needed) % RING_SAMPLES;
        count += needed;
      }

      function rbRead(dst) {
        // dst: Float32Array
        const n = dst.length;
        if (count <= 0) {
          dst.fill(0);
          return 0;
        }
        const take = Math.min(n, count);

        // Read with wrap
        const n1 = Math.min(take, RING_SAMPLES - rptr);
        dst.set(ring.subarray(rptr, rptr + n1), 0);
        if (take > n1) dst.set(ring.subarray(0, take - n1), n1);

        // If underrun, fill remainder with zeros
        if (take < n) dst.fill(0, take);

        rptr = (rptr + take) % RING_SAMPLES;
        count -= take;
        return take;
      }
