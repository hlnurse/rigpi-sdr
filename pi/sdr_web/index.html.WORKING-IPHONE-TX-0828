        })
        .catch(() => {});
      fetchState();
      // Defer WS until after first layout so canvas has non-zero width
      requestAnimationFrame(() => requestAnimationFrame(connectSpectrumWS));

      // ---- Memory Panel ----
      const MEM_COUNT = 20;
      let memories = new Array(MEM_COUNT).fill(null);
      let memSelected = new Set();
      let memScanning = false;
      let memScanIdx = 0;
      let memScanTimer = null;
      let activeMemIdx = -1; // which memory slot is currently active
      let squelchOpen = true; // current squelch state
      let swScanRunning = false;
      let swScanGeneration = 0;
      let swScanSession = null;
      let swStationSession = null;
      let activityRecordCloseTimer = null;
      const activityRecordMode = document.getElementById(
        "memActivityRecordMode",
      );
      const activityRecordFinish = document.getElementById(
        "memActivityRecordFinish",
      );
      const activityRecordStatus = document.getElementById(
        "memActivityRecordStatus",
      );

      function activityRecordingPrefix(session) {
        const memory = activeMemIdx >= 0 ? memories[activeMemIdx] : null;
        const slot = activeMemIdx >= 0 ? "M" + (activeMemIdx + 1) : "VFO";
        const caption = String(
          memory?.caption || memory?.label || memory?.name || "",
        )
          .replace(/[^A-Za-z0-9_-]+/g, "_")
          .replace(/^_+|_+$/g, "");
        const frequency = Math.round(
          Number(memory?.freq || state.tuned_freq || state.center_freq || 0),
        );
        return [
          session ? "activity_session" : "activity",
          slot,
          caption,
          frequency,
        ]
          .filter(Boolean)
          .join("_");
      }

      function activityRecordingState() {
        return window.rigPiRecording?.state?.() || "inactive";
      }

      function updateActivityRecordingStatus(text, color) {
        if (activityRecordStatus) {
          activityRecordStatus.textContent = text || "";
          activityRecordStatus.style.color = color || "#666";
        }
        if (activityRecordFinish) {
          activityRecordFinish.style.display =
            activityRecordMode?.value === "append" &&
            activityRecordingState() !== "inactive"
              ? ""
              : "none";
        }
      }

      function finishActivityRecording() {
        clearTimeout(activityRecordCloseTimer);
        activityRecordCloseTimer = null;
        const reason = window.rigPiRecording?.reason?.() || "";
        if (reason.startsWith("squelch-") && window.rigPiRecording.stop()) {
          updateActivityRecordingStatus("Saving…", "#f0ad4e");
          return true;
        }
        return false;
      }

      function activitySquelchChanged(open) {
        const mode = activityRecordMode?.value || "off";
        if (
          mode === "off" ||
          parseInt(squelchSlider?.value || "-140", 10) <= -140
        )
          return;
        clearTimeout(activityRecordCloseTimer);
        activityRecordCloseTimer = null;
        const recorder = window.rigPiRecording;
        if (!recorder) {
          updateActivityRecordingStatus("Recorder unavailable", "#f66");
          return;
        }
        const stateNow = recorder.state();
        const reason = recorder.reason();
        if (open) {
          if (stateNow === "inactive") {
            const started = recorder.start({
              prefix: activityRecordingPrefix(mode === "append"),
              reason: "squelch-" + mode,
            });
            updateActivityRecordingStatus(
              started ? "Recording" : "Start audio first",
              started ? "#f44" : "#f0ad4e",
            );
          } else if (
            mode === "append" &&
            reason === "squelch-append" &&
            stateNow === "paused"
          ) {
            recorder.resume();
            updateActivityRecordingStatus("Recording", "#f44");
          }
        } else if (reason === "squelch-separate" && stateNow !== "inactive") {
          activityRecordCloseTimer = setTimeout(() => {
            recorder.stop();
            updateActivityRecordingStatus("Saving clip…", "#f0ad4e");
          }, 500);
        } else if (reason === "squelch-append" && stateNow === "recording") {
          activityRecordCloseTimer = setTimeout(() => {
            recorder.pause();
            updateActivityRecordingStatus("Waiting", "#38bdf8");
          }, 500);
        }
        updateActivityRecordingStatus(
          activityRecordStatus?.textContent,
          activityRecordStatus?.style.color,
        );
      }

      if (activityRecordMode) {
        activityRecordMode.value =
          localStorage.getItem("rigpiActivityRecordMode") || "off";
        activityRecordMode.addEventListener("change", () => {
          finishActivityRecording();
          localStorage.setItem(
            "rigpiActivityRecordMode",
            activityRecordMode.value,
          );
          if (activityRecordMode.value === "off")
            updateActivityRecordingStatus("", "#666");
          else if (parseInt(squelchSlider?.value || "-140", 10) <= -140)
            updateActivityRecordingStatus("Set squelch", "#f0ad4e");
          else {
            updateActivityRecordingStatus("Armed", "#38bdf8");
            activitySquelchChanged(squelchOpen);
          }
        });
      }
      activityRecordFinish?.addEventListener("click", finishActivityRecording);
      window.addEventListener("rigpi-recording-saved", (event) => {
        if (String(event.detail?.reason || "").startsWith("squelch-"))
          updateActivityRecordingStatus("Saved", "#5cdb95");
      });

      // Squelch slider wiring
      const squelchSlider = document.getElementById("squelchSlider");
      const squelchLabel = document.getElementById("squelchLabel");
      const squelchLed = document.getElementById("squelchLed");
      // Initialize squelch slider fill on load
      if (squelchSlider) {
        updateSliderFill(squelchSlider);
      }

      squelchSlider.addEventListener("input", () => {
        const val = parseInt(squelchSlider.value, 10);
        squelchLabel.textContent = val <= -140 ? "OFF" : val + " dB";
        updateSliderFill(squelchSlider);
        if (activeMemIdx >= 0 && memories[activeMemIdx]) {
          memories[activeMemIdx].squelch = val;
          sendControl({ memories: memories });
        }
        // Save global squelch to user settings
        sendControl({ squelch: val });
        if (val <= -140) activitySquelchChanged(false);
        else activitySquelchChanged(squelchOpen);
      });

      function loadMemSquelch(idx) {
        const m = memories[idx];
        const sq = m && typeof m.squelch === "number" ? m.squelch : -140;
        squelchSlider.value = sq;
        squelchLabel.textContent = sq <= -140 ? "OFF" : sq + " dB";
        updateSliderFill(squelchSlider);
      }

      function applySquelch(peakDb) {
        const threshold = parseInt(squelchSlider.value, 10);
        const _sliderGain = () => {
          const pct = parseInt(
            document.getElementById("audioLevelSlider")?.value || "100",
            10,
          );
          return Math.min(2, pct / 100);
        };
        if (threshold <= -140) {
          // squelch off - always open
          if (!squelchOpen) {
            squelchOpen = true;
            if (masterGain)
              masterGain.gain.value = audioMuted ? 0 : _sliderGain();
            squelchLed.style.background = "#333";
          }
          return;
        }
        const open = peakDb >= threshold;
        if (open !== squelchOpen) {
          squelchOpen = open;
          const shouldPlay = !audioMuted && open;
          if (masterGain)
            masterGain.gain.value = shouldPlay ? _sliderGain() : 0;
          const audioEl = document.getElementById("webrtcAudio");
          if (audioEl) audioEl.muted = !shouldPlay;
          squelchLed.style.background = open ? "#00cc00" : "#cc0000";

          // Scan hold: pause when squelch opens, resume when it closes
          if (memScanning) {
            if (open) {
              // Signal found - pause scan timer
              clearTimeout(memScanTimer);
              memScanTimer = null;
            } else {
              // Signal gone - resume scan after dwell
              if (!memScanTimer) {
                memScanTimer = setTimeout(doScanStep, memDwell());
              }
            }
          }
          activitySquelchChanged(open);
        } else if (open && activityRecordingState() === "inactive") {
          // If audio was started after activity recording was armed, retry on
          // the next open-squelch sample without waiting for another transition.
          activitySquelchChanged(true);
        }
      }

      function memDwell() {
        return (
          parseInt(document.getElementById("memDwellSlider").value, 10) * 1000
        );
      }

      function memFreqLabel(freq) {
        if (!freq) return "—";
        return (freq / 1e6).toFixed(4) + " MHz";
      }

      function tuneStoredMemory(idx) {
        const m = memories[idx];
        if (!m) return;
        const freq = Math.round(Number(m.freq ?? m.frequency));
        const mode = String(m.mode || state.mode || "USB")
          .trim()
          .toUpperCase();
        const bw = Math.max(
          1,
          Math.round(Number(m.bw ?? m.bandwidth) || getDefaultBW(mode)),
        );
        if (!Number.isFinite(freq) || freq <= 0) return;

        activeMemIdx = idx;
        fibSelectedActionKey = `memory:${idx}`;
        state.center_freq = freq;
        state.displayCenter = freq;
        state.tuned_freq = freq;
        state._exactFreq = freq;
        state.mode = mode;
        state.bw = bw;

        // Stage the FFT viewport at the recalled frequency immediately. Without
        // this, memory recall leaves the old zero-bin offset in place for one
        // polling cycle, so the trace briefly snaps to the center marker before
        // moving to the recalled position.
        const memoryHwCenter = Number(state.hw_center);
        const memorySampleRate = Number(window._sdrSampleRate);
        const memoryFftSize = Number(window._sdrFftSize);
        if (
          Number.isFinite(memoryHwCenter) &&
          Number.isFinite(memorySampleRate) &&
          memorySampleRate > 0 &&
          Number.isFinite(memoryFftSize) &&
          memoryFftSize > 1
        ) {
          const memoryHzPerBin = memorySampleRate / memoryFftSize;
          const memoryMaxBinOffset = Math.floor(memoryFftSize / 2) - 1;
          const memoryBinOffset = Math.round(
            (freq - memoryHwCenter) / memoryHzPerBin,
          );
          state._dispBinOffset = Math.max(
            -memoryMaxBinOffset,
            Math.min(memoryMaxBinOffset, memoryBinOffset),
          );
        }
        freqEditHold = Date.now() + 3000;
        modeEditing = true;
        modeBwHoldUntil = Date.now() + 4000;

        // A memory recall is one atomic frequency/mode/BW tune. Register its
        // frequency as pending before posting so an older rig-state poll cannot
        // delay the selection or move the display back to the previous memory.
        pendingTuneHz = freq;
        pendingTuneStartedAt = Date.now();
        renderFreqLED(freq);
        buildSpectrumGrid();
        updateModeBW();
        loadMemSquelch(idx);
        renderMemGrid();

        // Do not follow this with a delayed /api/control mode write. That old
        // completion could arrive after a newer manual mode choice and restore
        // the memory's mode (for example CW/500 over PKTUSD).
        postTuneRequest({
          freq,
          mode,
          bw,
          callsign: window._sdrCallsign || "",
          radio: window._sdrRadio || 1,
          user: window._sdrUser || "admin",
        }).catch((err) => console.error("memory recall failed:", err));

        // State polling releases this guard only after the server reports both
        // the requested mode and bandwidth together.
        setTimeout(() => {
          if (Date.now() >= modeBwHoldUntil) modeEditing = false;
        }, 4100);
      }

      function saveStoredMemory(idx) {
        const previous =
          memories[idx] && typeof memories[idx] === "object"
            ? memories[idx]
            : {};
        const suggested = String(
          previous.caption || previous.label || previous.name || "",
        ).trim();
        const entered = window.prompt(
          `Caption for Memory ${idx + 1} (optional):`,
          suggested,
        );
        if (entered === null) return;
        const caption = String(entered).trim();
        memories[idx] = {
          freq: Math.round(Number(state.tuned_freq || state.center_freq)),
          mode: String(state.mode || "USB").toUpperCase(),
          bw: Math.max(
            1,
            Math.round(Number(state.bw) || getDefaultBW(state.mode || "USB")),
          ),
          squelch: parseInt(squelchSlider?.value || "-140", 10),
          caption,
        };
        activeMemIdx = idx;
        fibSelectedActionKey = `memory:${idx}`;
        renderMemGrid();
        sendControl({ memories: memories });
      }

      function renderMemGrid() {
        const grid = document.getElementById("memGrid");
        if (!grid) return;
        grid.innerHTML = "";
        for (let i = 0; i < MEM_COUNT; i++) {
          const m = memories[i];
          const selected = memSelected.has(i);
          const btn = document.createElement("button");
          btn.dataset.idx = i;
          const isActive = i === activeMemIdx;
          const bg = selected ? "#cc7700" : m ? "#007700" : "#1a1a1a";
          const border = selected ? "#ffaa00" : m ? "#00aa00" : "#333";
          const color = m ? "#ffffff" : "#444";
          btn.style.cssText = [
            "font-size:10px",
            "padding:3px 4px",
            "text-align:left",
            "background:" + bg,
            "color:" + color,
            "border:1px solid " + border,
            "border-radius:3px",
            "cursor:pointer",
            "line-height:1.3",
            "white-space:nowrap",
            "overflow:hidden",
            "text-overflow:ellipsis",
            "position:relative",
          ].join(";");
          // Orange dot indicator for scan-selected
          const dot = isActive
            ? "<span style='position:absolute;top:2px;right:3px;width:9px;height:9px;border-radius:50%;background:#00ff00;display:inline-block;pointer-events:none;box-shadow:0 0 3px #00ff00;'></span>"
            : "";
          btn.innerHTML =
            dot +
            "<span style='color:#aaffaa;font-size:9px;'>M" +
            (i + 1) +
            "</span><br>" +
            (m
              ? (m.caption || m.label || m.name
                  ? "<span style='color:#ffffff;font-size:9px;font-weight:600;'>" +
                    String(m.caption || m.label || m.name).replace(
                      /[&<>"']/g,
                      (ch) =>
                        ({
                          "&": "&amp;",
                          "<": "&lt;",
                          ">": "&gt;",
                          '"': "&quot;",
                          "'": "&#39;",
                        })[ch],
                    ) +
                    "</span><br>"
                  : "") +
                memFreqLabel(m.freq) +
                "<br><span style='color:#aaffaa;font-size:9px;'>" +
                m.mode +
                " " +
                (m.bw / 1000).toFixed(1) +
                "k</span>"
              : "<span style='font-size:9px;'>empty</span>");

          btn.addEventListener("click", (e) => {
            if (e.ctrlKey || e.metaKey) {
              if (memSelected.has(i)) memSelected.delete(i);
              else memSelected.add(i);
              renderMemGrid();
              return;
            }
            if (!memories[i]) return;
            tuneStoredMemory(i);
          });

          btn.addEventListener("contextmenu", (e) => {
            e.preventDefault();
            saveStoredMemory(i);
          });

          let memPressTimer = null;
          let memPressStartX = 0;
          let memPressStartY = 0;
          const cancelMemPress = () => {
            if (memPressTimer) clearTimeout(memPressTimer);
            memPressTimer = null;
          };
          btn.addEventListener("pointerdown", (e) => {
            if (e.button !== 0) return;
            memPressStartX = e.clientX;
            memPressStartY = e.clientY;
            cancelMemPress();
            memPressTimer = setTimeout(() => {
              memPressTimer = null;
              btn._memoryLongPressed = true;
              saveStoredMemory(i);
            }, 650);
          });
          btn.addEventListener("pointermove", (e) => {
            if (
              Math.hypot(
                e.clientX - memPressStartX,
                e.clientY - memPressStartY,
              ) > 8
            )
              cancelMemPress();
          });
          btn.addEventListener("pointerup", cancelMemPress);
          btn.addEventListener("pointercancel", cancelMemPress);
          btn.addEventListener(
            "click",
            (e) => {
              if (btn._memoryLongPressed) {
                e.preventDefault();
                e.stopImmediatePropagation();
                btn._memoryLongPressed = false;
              }
            },
            true,
          );

          grid.appendChild(btn);
        }
      }

      document
        .getElementById("memDwellSlider")
        .addEventListener("input", () => {
          document.getElementById("memDwellLabel").textContent =
            document.getElementById("memDwellSlider").value + "s";
        });

      document.getElementById("memScanBtn").addEventListener("click", () => {
        if (memScanning) {
          memScanning = false;
          clearTimeout(memScanTimer);
          document.getElementById("memScanBtn").textContent = "SCAN";
          document.getElementById("memScanBtn").style.background = "";
          if (activityRecordMode?.value !== "off") finishActivityRecording();
        } else {
          const sel = [...memSelected].filter((i) => memories[i]);
          if (sel.length < 2) {
            alert(
              "Select at least 2 memories for scan:\nCtrl+click (or Cmd+click on Mac) to select/deselect.",
            );
            return;
          }
          memScanning = true;
          memScanIdx = 0;
          document.getElementById("memScanBtn").textContent = "STOP";
          document.getElementById("memScanBtn").style.background = "#c0392b";
          doScanStep();
        }
      });

      function doScanStep() {
        if (!memScanning) return;
        const sel = [...memSelected]
          .sort((a, b) => a - b)
          .filter((i) => memories[i]);
        if (!sel.length) {
          memScanning = false;
          return;
        }
        memScanIdx = memScanIdx % sel.length;
        const m = memories[sel[memScanIdx]];
        console.log("[SCAN] stepping to slot", sel[memScanIdx], m.freq, m.mode);
        activeMemIdx = sel[memScanIdx];
        loadMemSquelch(activeMemIdx);
        renderMemGrid();
        tuneStoredMemory(sel[memScanIdx]);
        memScanIdx = (memScanIdx + 1) % sel.length;
        memScanTimer = setTimeout(doScanStep, memDwell());
      }

      const swScanButton = document.getElementById("swScanBtn");
      const swScanStatus = document.getElementById("swScanStatus");

      function swScanMessage(status, detail = {}) {
        const payload = { type: "rigpi-elmer-scan-status", status, ...detail };
        if (window.parent !== window) window.parent.postMessage(payload, "*");
      }

      function setSwScanUi(running, text, color = "#777") {
        swScanRunning = Boolean(running);
        if (swScanButton) {
          swScanButton.textContent = running
            ? "STOP SW"
            : swScanSession?.index < swScanSession?.windows?.length
              ? "RESUME SW"
              : "SW SCAN";
          swScanButton.style.background = running ? "#c0392b" : "";
        }
        if (swScanStatus) {
          swScanStatus.textContent = text || "Scheduled broadcasts";
          swScanStatus.style.color = color;
        }
      }

      function stopShortwaveScan(reason = "stopped") {
        if (!swScanRunning) return false;
        swScanGeneration += 1;
        setSwScanUi(
          false,
          reason === "stopped" ? "Scan stopped" : reason,
          "#aaa",
        );
        swScanMessage("stopped", {
          message: "Shortwave broadcast scan stopped.",
        });
        return true;
      }

      function waitForSwScan(milliseconds, generation) {
        return new Promise((resolve) =>
          window.setTimeout(
            () => resolve(swScanRunning && generation === swScanGeneration),
            milliseconds,
          ),
        );
      }

      async function waitForShortwaveCaptureCenter(
        frequency,
        timeoutMs = 2500,
      ) {
        const started = Date.now();
        const tolerance = Math.max(
          100,
          Number(window._sdrSampleRate || 912000) / 4096,
        );
        let lastCenter = NaN;
        while (Date.now() - started < timeoutMs) {
          const response = await fetch(
            (window._sdrBase || "") + "/api/fft/snapshot",
            { cache: "no-store" },
          );
          const snapshot = await response.json().catch(() => ({}));
          lastCenter = Number(snapshot.center_freq ?? snapshot.hw_center);
          if (
            response.ok &&
            Number.isFinite(lastCenter) &&
            Math.abs(lastCenter - frequency) <= tolerance
          )
            return snapshot;
          await new Promise((resolve) => window.setTimeout(resolve, 120));
        }
        throw new Error(
          Number.isFinite(lastCenter)
            ? `The SDR remained centered on ${(lastCenter / 1e6).toFixed(3)} MHz.`
            : "The SDR did not confirm its scan frequency.",
        );
      }

      async function tuneShortwaveCandidate(candidate) {
        const action = candidate?.action || {};
        const frequency = Math.round(Number(action.frequency));
        if (
          !Number.isFinite(frequency) ||
          frequency < 2_300_000 ||
          frequency > 30_000_000
        )
          throw new Error("The schedule contained an invalid frequency.");
        // Scanning must move the capture itself, not merely the demodulator
        // slice inside a possibly stale capture. Otherwise an apparently
        // visible signal to either side is measured against the wrong bins.
        pendingTuneHz = frequency;
        pendingTuneStartedAt = Date.now();
        state.tuned_freq = frequency;
        const tuneResponse = await postTuneRequest({
          freq: frequency,
          mode: "AM",
          bw: 6000,
          callsign: window._sdrCallsign || "",
          radio: window._sdrRadio || 1,
          user: window._sdrUser || "admin",
          slice_only: false,
        });
        const tuneResult = await tuneResponse.json().catch(() => ({}));
        if (!tuneResult.ok || tuneResult.hw_retuned === false)
          throw new Error("The SDR did not retune its scan window.");
        await waitForShortwaveCaptureCenter(frequency);
        state._dispBinOffset = 0;
        state.displayCenter = frequency;
        state.center_freq = frequency;
        state.hw_center = frequency;
        state._lastHwCenter = frequency;
        state._exactFreq = frequency;
        renderFreqLED(frequency);
        buildSpectrumGrid();
        state.mode = "AM";
        state.bw = 6000;
        modeEditing = true;
        modeBwHoldUntil = Date.now() + 4000;
        updateModeBW();
        await sendControl({ mode: "AM", bw: 6000 });
        window.setTimeout(() => {
          if (Date.now() >= modeBwHoldUntil) modeEditing = false;
        }, 4100);
        return frequency;
      }

      async function checkShortwaveSignal(frequency) {
        const url =
          (window._sdrBase || "") +
          `/api/signal_check?freq_hz=${encodeURIComponent(frequency)}&bw_hz=6000`;
        let last = null;
        for (let attempt = 0; attempt < 2; attempt += 1) {
          const response = await fetch(url, { cache: "no-store" });
          last = await response.json().catch(() => ({}));
          if (response.ok && last.ok) return last;
          if (
            attempt === 0 &&
            /out of SDR range/i.test(String(last.error || ""))
          ) {
            await new Promise((resolve) => window.setTimeout(resolve, 650));
            continue;
          }
          break;
        }
        throw new Error(last?.error || "Signal measurement failed.");
      }

      function shortwaveSignalPassesSquelch(measurement) {
        const threshold = Number(squelchSlider?.value ?? -140);
        const peak = Number(measurement?.signal_peak_db);
        const mean = Number(measurement?.signal_mean_db);
        const noise = Number(measurement?.noise_floor_db);
        // A lone carrier or FFT spur can have a large peak while the rest of
        // the 6 kHz AM channel is empty. Require repeatable energy across the
        // passband as well as the carrier peak before calling it audible.
        const hasPassbandEnergy =
          Number.isFinite(mean) &&
          Number.isFinite(noise) &&
          mean - noise >= 2.5;
        const hasCarrier = Boolean(measurement?.detected);
        if (Number.isFinite(threshold) && threshold > -140) {
          return peak >= threshold && hasCarrier && hasPassbandEnergy;
        }
        return hasCarrier && hasPassbandEnergy;
      }

      async function createShortwaveScanSession() {
        const response = await fetch(
          (window._sdrBase || "") +
            "/api/shortwave/schedule?low_hz=2300000&high_hz=30000000",
          { cache: "no-store" },
        );
        const schedule = await response.json().catch(() => ({}));
        if (!response.ok)
          throw new Error(
            schedule.error || "The broadcast schedule is unavailable.",
          );
        const candidates = Array.isArray(schedule.objects)
          ? schedule.objects.filter((item) => {
              const frequency = Number(item?.action?.frequency);
              const note = String(item?.note || "");
              if (!Number.isFinite(frequency)) return false;
              // EiBi includes an irregular 27.184 MHz pirate listing one kHz
              // below CB channel 19. A 6 kHz AM detector cannot distinguish it
              // from ordinary 27.185 MHz CB traffic, so broadcast scans exclude
              // the US 40-channel CB allocation and tentative/irregular entries.
              if (frequency >= 26_965_000 && frequency <= 27_405_000)
                return false;
              if (/^Tentative\/irregular schedule\./i.test(note)) return false;
              return true;
            })
          : [];
        if (!candidates.length)
          throw new Error("No shortwave broadcasts are scheduled right now.");
        const current = Number(state.tuned_freq || state.center_freq || 0);
        candidates.sort(
          (left, right) =>
            Number(left.action.frequency) - Number(right.action.frequency),
        );
        const captureWidth = Math.max(
          300_000,
          Math.min(700_000, Number(window._sdrSampleRate || 912_000) * 0.68),
        );
        const windows = [];
        for (let start = 0; start < candidates.length; ) {
          const firstFrequency = Number(candidates[start].action.frequency);
          let stop = start + 1;
          while (
            stop < candidates.length &&
            Number(candidates[stop].action.frequency) - firstFrequency <=
              captureWidth
          )
            stop += 1;
          const items = candidates.slice(start, stop);
          const lastFrequency = Number(items.at(-1).action.frequency);
          windows.push({
            center: Math.round((firstFrequency + lastFrequency) / 2),
            items,
          });
          start = stop;
        }
        windows.sort(
          (left, right) =>
            Math.abs(left.center - current) - Math.abs(right.center - current),
        );
        return { candidates, windows, index: 0 };
      }

      async function startShortwaveScan(resume = false) {
        if (swScanRunning) return;
        if (!resume) swStationSession = null;
        if (memScanning) {
          memScanning = false;
          clearTimeout(memScanTimer);
          document.getElementById("memScanBtn").textContent = "SCAN";
          document.getElementById("memScanBtn").style.background = "";
        }
        const generation = ++swScanGeneration;
        const canResume = Boolean(
          resume &&
            swScanSession?.windows?.length &&
            swScanSession.index < swScanSession.windows.length,
        );
        setSwScanUi(
          true,
          canResume ? "Resuming scan…" : "Loading current schedule…",
          "#38bdf8",
        );
        swScanMessage("loading", {
          message: canResume
            ? "Resuming after the last detected signal…"
            : "Loading broadcasts scheduled now…",
        });
        try {
          if (!canResume) swScanSession = await createShortwaveScanSession();
          const { candidates, windows } = swScanSession;
          const startIndex = canResume ? swScanSession.index : 0;
          const squelchThreshold = Number(squelchSlider?.value ?? -140);
          const detectorDescription =
            Number.isFinite(squelchThreshold) && squelchThreshold > -140
              ? `squelch ${squelchThreshold} dB`
              : "6 dB SNR detector (squelch off)";
          swScanMessage("started", {
            message: `Scanning ${candidates.length} scheduled frequencies in ${windows.length} spectrum windows using ${detectorDescription}.`,
            total: windows.length,
          });
          for (let index = startIndex; index < windows.length; index += 1) {
            if (!swScanRunning || generation !== swScanGeneration) return;
            swScanSession.index = index;
            const scanWindow = windows[index];
            const frequency = scanWindow.center;
            const lowKhz = Math.round(
              Number(scanWindow.items[0].action.frequency) / 1000,
            );
            const highKhz = Math.round(
              Number(scanWindow.items.at(-1).action.frequency) / 1000,
            );
            const progress = `${index + 1}/${windows.length} · ${lowKhz.toLocaleString()}–${highKhz.toLocaleString()} kHz · ${scanWindow.items.length} scheduled`;
            setSwScanUi(true, progress, "#facc15");
            swScanMessage("progress", {
              message: progress,
              index: index + 1,
              total: windows.length,
              frequency_hz: frequency,
            });
            await tuneShortwaveCandidate({ action: { frequency } });
            if (!(await waitForSwScan(1350, generation))) return;
            const measured = await Promise.all(
              scanWindow.items.map(async (candidate) => {
                const candidateFrequency = Math.round(
                  Number(candidate.action.frequency),
                );
                try {
                  const measurement =
                    await checkShortwaveSignal(candidateFrequency);
                  return {
                    candidate,
                    frequency: candidateFrequency,
                    measurement,
                  };
                } catch (_) {
                  return null;
                }
              }),
            );
            const firstDetections = measured.filter(
              (item) =>
                item?.measurement &&
                shortwaveSignalPassesSquelch(item.measurement),
            );
            if (
              firstDetections.length &&
              !(await waitForSwScan(260, generation))
            )
              return;
            const confirmed = await Promise.all(
              firstDetections.map(async (item) => {
                try {
                  const second = await checkShortwaveSignal(item.frequency);
                  return shortwaveSignalPassesSquelch(second)
                    ? { ...item, measurement: second }
                    : null;
                } catch (_) {
                  return null;
                }
              }),
            );
            const detected = confirmed
              .filter(Boolean)
              .sort(
                (left, right) =>
                  Number(right.measurement.snr_db) -
                  Number(left.measurement.snr_db),
              );
            if (detected.length) {
              const best = detected[0];
              const label = String(
                best.candidate.shortLabel ||
                  best.candidate.longLabel ||
                  "Scheduled broadcast",
              );
              await tuneShortwaveCandidate(best.candidate);
              const detectedLevel =
                squelchThreshold > -140
                  ? `${best.measurement.signal_peak_db} dB (SQL ${squelchThreshold})`
                  : `${best.measurement.snr_db} dB SNR`;
              swScanSession.index = index + 1;
              setSwScanUi(
                false,
                `${label} · ${(best.frequency / 1000).toFixed(0)} kHz · ${detectedLevel}`,
                "#22c55e",
              );
              swScanMessage("found", {
                message: `Signal found: ${label} on ${(best.frequency / 1000).toFixed(0)} kHz.`,
                station: label,
                frequency_hz: best.frequency,
                snr_db: Number(best.measurement.snr_db),
                signal_peak_db: Number(best.measurement.signal_peak_db),
              });
              return;
            }
          }
          swScanSession = null;
          setSwScanUi(false, "No scheduled signal detected", "#aaa");
          swScanMessage("complete", {
            message: "No scheduled shortwave signal was detected.",
          });
        } catch (error) {
          if (!swScanRunning || generation !== swScanGeneration) return;
          const message = String(error?.message || "Shortwave scan failed.");
          setSwScanUi(false, message, "#ef4444");
          swScanMessage("error", { message });
        } finally {
          if (generation === swScanGeneration) swScanRunning = false;
        }
      }

      function normalizedStationName(value) {
        return String(value || "")
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, " ")
          .trim();
      }

      function normalizedScheduleLookupQuery(value) {
        const query = String(value || "").trim();
        const language = query.match(
          /^(?:(?:shortwave|sw)\s+)?(?:broadcast(?:s|\s+stations)?\s+in|broadcasting\s+in)\s+(.+)$/i,
        );
        return String(language?.[1] || query).trim();
      }

      async function restoreAfterStationLookup(origin) {
        const frequency = Math.round(Number(origin?.frequency_hz));
        if (!Number.isFinite(frequency) || frequency <= 0) return;
        const mode = String(origin?.mode || state.mode || "AM").toUpperCase();
        const bandwidth = Math.max(
          1,
          Math.round(Number(origin?.bandwidth_hz) || getDefaultBW(mode)),
        );
        sendTune(frequency);
        state.mode = mode;
        state.bw = bandwidth;
        modeEditing = true;
        modeBwHoldUntil = Date.now() + 4000;
        updateModeBW();
        await sendControl({ mode, bw: bandwidth });
        window.setTimeout(() => {
          if (Date.now() >= modeBwHoldUntil) modeEditing = false;
        }, 4100);
      }

      async function tuneScheduledStation(query, resume = false) {
        if (swScanRunning) stopShortwaveScan("Station lookup started");
        const generation = ++swScanGeneration;
        swScanRunning = true;
        query = normalizedScheduleLookupQuery(
          query || swStationSession?.query || "",
        );
        const requested = normalizedStationName(query);
        if (requested.length < 2) {
          swScanRunning = false;
          throw new Error("Enter a broadcast-station name.");
        }
        let origin = {
          frequency_hz: Number(state.tuned_freq || state.center_freq),
          mode: String(state.mode || "AM"),
          bandwidth_hz: Number(state.bw || 0),
        };
        setSwScanUi(true, `Finding ${query}…`, "#38bdf8");
        swScanMessage("station-progress", {
          message: `Finding active frequencies for ${query}…`,
        });
        try {
          const response = await fetch(
            (window._sdrBase || "") +
              "/api/shortwave/schedule?low_hz=2300000&high_hz=30000000",
            { cache: "no-store" },
          );
          const schedule = await response.json().catch(() => ({}));
          if (!response.ok)
            throw new Error(
              schedule.error || "The broadcast schedule is unavailable.",
            );
          const scored = (
            Array.isArray(schedule.objects) ? schedule.objects : []
          )
            .map((candidate) => {
              const label = normalizedStationName(
                candidate.shortLabel || candidate.longLabel,
              );
              const searchable = normalizedStationName(
                `${candidate.shortLabel || ""} ${candidate.longLabel || ""} ${candidate.note || ""}`,
              );
              const score =
                label === requested
                  ? 100
                  : label.startsWith(requested)
                    ? 90
                    : label.includes(requested)
                      ? 80
                      : searchable.includes(requested)
                        ? 40
                        : 0;
              return { candidate, score };
            })
            .filter((item) => item.score > 0);
          if (!scored.length)
            throw new Error(
              `No active scheduled broadcast matched “${query}”.`,
            );
          // A frequency object can contain several simultaneous stations. For
          // example, WWV is secondary to BPM on several time-signal channels.
          // Keep every object containing the requested station, rather than
          // discarding secondary entries when one primary label is exact.
          const matchesByFrequency = new Map();
          for (const item of scored.sort(
            (left, right) => right.score - left.score,
          )) {
            const frequency = Number(item.candidate?.action?.frequency);
            if (
              Number.isFinite(frequency) &&
              !matchesByFrequency.has(frequency)
            ) {
              matchesByFrequency.set(frequency, item.candidate);
            }
          }
          const matches = [...matchesByFrequency.values()];
          let measurements = [];
          let startIndex = 0;
          if (resume && swStationSession?.query === query) {
            origin = swStationSession.origin || origin;
            measurements = Array.isArray(swStationSession.measurements)
              ? swStationSession.measurements
              : [];
            startIndex = Math.max(
              0,
              Math.min(matches.length, Number(swStationSession.index) || 0),
            );
          } else {
            swStationSession = { query, origin, measurements, index: 0 };
          }
          swStationSession = { query, origin, measurements, index: startIndex };
          for (let index = startIndex; index < matches.length; index += 1) {
            if (!swScanRunning || generation !== swScanGeneration) return;
            swStationSession.index = index;
            const candidate = matches[index];
            const frequency = Math.round(Number(candidate.action.frequency));
            setSwScanUi(
              true,
              `${query} · ${index + 1}/${matches.length} · ${(frequency / 1000).toFixed(0)} kHz`,
              "#facc15",
            );
            swScanMessage("station-progress", {
              message: `Checking ${query} on ${(frequency / 1000).toFixed(0)} kHz…`,
            });
            await tuneShortwaveCandidate(candidate);
            await new Promise((resolve) => window.setTimeout(resolve, 1150));
            if (!swScanRunning || generation !== swScanGeneration) return;
            try {
              const measurement = await checkShortwaveSignal(frequency);
              measurements.push({ candidate, frequency, measurement });
            } catch (_) {
              measurements.push({
                candidate,
                frequency,
                measurement: { snr_db: -999 },
              });
            }
            swStationSession.index = index + 1;
          }
          let heard = measurements.filter((item) =>
            shortwaveSignalPassesSquelch(item.measurement),
          );
          heard.sort(
            (left, right) =>
              Number(right.measurement.snr_db) -
              Number(left.measurement.snr_db),
          );
          const confirmedHeard = [];
          for (const item of heard) {
            await tuneShortwaveCandidate(item.candidate);
            await new Promise((resolve) => window.setTimeout(resolve, 550));
            if (!swScanRunning || generation !== swScanGeneration) return;
            try {
              const confirmation = await checkShortwaveSignal(item.frequency);
              if (shortwaveSignalPassesSquelch(confirmation)) {
                confirmedHeard.push({ ...item, measurement: confirmation });
                break;
              }
            } catch (_) {}
          }
          heard = confirmedHeard;
          const alternatives = measurements
            .map((item) => item.frequency)
            .sort((a, b) => a - b);
          if (!heard.length) {
            await restoreAfterStationLookup(origin);
            swStationSession = null;
            const threshold = Number(squelchSlider?.value ?? -140);
            const detector =
              threshold > -140
                ? `squelch ${threshold} dB plus AM passband energy`
                : "the carrier and AM passband detector";
            setSwScanUi(false, `No ${query} signal detected`, "#aaa");
            swScanMessage("station-not-found", {
              message: `No ${query} signal passed ${detector}. The previous frequency was restored.`,
              station: query,
              alternatives_hz: alternatives,
              detector,
            });
            return;
          }
          const best = heard[0];
          await tuneShortwaveCandidate(best.candidate);
          swStationSession = null;
          const label = String(
            query || best.candidate.shortLabel || best.candidate.longLabel,
          );
          try {
            localStorage.setItem(
              "rigPiLastScheduledStation",
              JSON.stringify({
                station: label,
                frequency_hz: best.frequency,
                saved_at: new Date().toISOString(),
              }),
            );
          } catch (_) {}
          setSwScanUi(
            false,
            `${label} · ${(best.frequency / 1000).toFixed(0)} kHz`,
            "#22c55e",
          );
          swScanMessage("station-tuned", {
            message: `${label} tuned on ${(best.frequency / 1000).toFixed(0)} kHz.`,
            station: label,
            frequency_hz: best.frequency,
            snr_db: Number(best.measurement.snr_db),
            alternatives_hz: alternatives,
          });
        } catch (error) {
          if (!swScanRunning || generation !== swScanGeneration) return;
          const message = String(
            error?.message || "Scheduled-station lookup failed.",
          );
          swStationSession = null;
          setSwScanUi(false, message, "#ef4444");
          swScanMessage("error", { message });
        } finally {
          if (generation === swScanGeneration) swScanRunning = false;
        }
      }

      function resumeShortwaveScan() {
        if (swScanRunning) return;
        if (swStationSession?.query)
          tuneScheduledStation(swStationSession.query, true);
        else startShortwaveScan(true);
      }

      if (swScanButton)
        swScanButton.addEventListener("click", () => {
          if (swScanRunning) stopShortwaveScan();
          else if (swStationSession?.query || swScanSession)
            resumeShortwaveScan();
          else startShortwaveScan(false);
        });

      window.rigPiShortwaveScan = {
        start: startShortwaveScan,
        resume: resumeShortwaveScan,
        tuneStation: tuneScheduledStation,
        stop: stopShortwaveScan,
        state: () => ({
          running: swScanRunning,
          resumable: Boolean(
            swStationSession?.query ||
              swScanSession?.index < swScanSession?.windows?.length,
          ),
        }),
      };
      window.addEventListener("message", (event) => {
        if (
          event.source !== window.parent ||
          !event.data ||
          event.data.type !== "rigpi-elmer-scan"
        )
          return;
        if (event.data.action === "stop") stopShortwaveScan();
        else if (
          event.data.action === "start" &&
          event.data.kind === "shortwave"
        )
          startShortwaveScan();
        else if (
          event.data.action === "resume" &&
          event.data.kind === "shortwave"
        )
          resumeShortwaveScan();
        else if (
          event.data.action === "tune-station" &&
          event.data.kind === "shortwave"
        ) {
          tuneScheduledStation(String(event.data.station_query || ""));
        }
      });

      // Elmer Control normally talks to a Hamlib-controlled transceiver.  A
      // HackRF is the receiver itself, so receive-only commands must enter
      // through the SDR page that owns the device.  Keep this bridge narrow:
      // it deliberately supports no transmit action.
      window.addEventListener("message", async (event) => {
        if (
          event.source !== window.parent ||
          !event.data ||
          event.data.type !== "rigpi-elmer-sdr-control"
        )
          return;

        const requestId = String(event.data.request_id || "");
        const reply = (payload) =>
          window.parent.postMessage(
            {
              type: "rigpi-elmer-sdr-result",
              request_id: requestId,
              ...payload,
            },
            "*",
          );

        const driver = String(
          state.device_driver || window._sdrLastState?.device_driver || "",
        ).toLowerCase();

        if (event.data.action === "probe") {
          reply({
            ok: true,
            device_driver: driver,
            frequency_hz: Math.round(Number(currentTunedFrequency()) || 0),
            mode: String(state.mode || ""),
            bandwidth_hz: Math.round(Number(state.bw) || 0),
          });
          return;
        }

        if (driver !== "hackrf") {
          reply({ ok: false, error: "The selected SDR is not a HackRF." });
          return;
        }
        if (event.data.action !== "receiver.tune") {
          reply({ ok: false, error: "That HackRF control is not available." });
          return;
        }

        try {
          const requestedFrequency = Number(event.data.frequency_hz);
          const requestedMode = String(event.data.mode || "").toUpperCase();
          const requestedBandwidth = Number(event.data.bandwidth_hz);

          if (Number.isFinite(requestedFrequency) && requestedFrequency > 0) {
            sendTune(Math.round(requestedFrequency));
          }
          if (requestedMode) state.mode = requestedMode;
          if (Number.isFinite(requestedBandwidth) && requestedBandwidth > 0) {
            state.bw = Math.round(requestedBandwidth);
          }
          if (
            requestedMode ||
            (Number.isFinite(requestedBandwidth) && requestedBandwidth > 0)
          ) {
            modeEditing = true;
            modeBwHoldUntil = Date.now() + 4000;
            updateModeBW();
            await sendControl({ mode: state.mode, bw: state.bw });
            window.setTimeout(() => {
              if (Date.now() >= modeBwHoldUntil) modeEditing = false;
            }, 4100);
          }

          // Let the SDR tune request and its state poll settle before reporting
          // a verified result to the parent Tuner window.
          await new Promise((resolve) => window.setTimeout(resolve, 550));
          const verifiedFrequency = Math.round(
            Number(currentTunedFrequency()) || 0,
          );
          const tolerance = Math.max(
            10,
            Number(window._sdrSampleRate || 912000) / 65536,
          );
          if (
            Number.isFinite(requestedFrequency) &&
            requestedFrequency > 0 &&
            Math.abs(verifiedFrequency - requestedFrequency) > tolerance
          ) {
            throw new Error(
              "The HackRF did not confirm the requested frequency.",
            );
          }
          reply({
            ok: true,
            action: "receiver.tune",
            radio: Number(window._sdrRadio || 1),
            device_driver: driver,
            verified_frequency_hz: verifiedFrequency,
            verified_mode: String(state.mode || ""),
            verified_bandwidth_hz: Math.round(Number(state.bw) || 0),
          });
        } catch (error) {
          reply({
            ok: false,
            error: error?.message || "The HackRF receive change failed.",
          });
        }
      });

      let hackrfPttPc = null;
      let hackrfPttStream = null;
      let hackrfPttHeartbeat = null;

      async function hackrfTxBridge(payload) {
        const response = await fetch("/programs/HackRFTx.php", {
          method: "POST",
          credentials: "same-origin",
          headers: {
            "Content-Type": "application/json",
            "X-RigPi-Action": "hackrf-tx",
          },
          body: JSON.stringify(payload),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok)
          throw new Error(data.error || "HackRF transmit failed.");
        return data;
      }

      async function stopHackrfPtt() {
        if (hackrfPttHeartbeat) window.clearInterval(hackrfPttHeartbeat);
        hackrfPttHeartbeat = null;
        try {
          await hackrfTxBridge({ action: "stop" });
        } catch (_) {}
        if (hackrfPttPc) {
          try {
            await hackrfPttPc.close();
          } catch (_) {}
        }
        hackrfPttPc = null;
        if (hackrfPttStream) {
          hackrfPttStream.getTracks().forEach((track) => track.stop());
        }
        hackrfPttStream = null;
      }

      async function startHackrfPtt() {
        const live = window._sdrLastState || {};
        if (
          String(
            live.device_driver || state.device_driver || "",
          ).toLowerCase() !== "hackrf"
        ) {
          throw new Error("The selected SDR is not a HackRF.");
        }
        if (!live.hackrf_tx?.enabled) {
          throw new Error("HackRF transmit is disabled by the administrator.");
        }
        if (hackrfPttPc) return;
        const source = document.getElementById("audioSource")?.value || "";
        const hackrfMic = {
          echoCancellation: false,
          noiseSuppression: false,
          autoGainControl: false,
          channelCount: 1,
        };
        if (source && source !== "__default__") {
          hackrfMic.deviceId = { exact: source };
        }
        const constraints = { audio: hackrfMic };
        hackrfPttStream =
          await navigator.mediaDevices.getUserMedia(constraints);
        const pc = new RTCPeerConnection({
          iceServers: [{ urls: "stun:stun.l.google.com:19302" }],
        });
        hackrfPttPc = pc;
        hackrfPttStream
          .getAudioTracks()
          .forEach((track) => pc.addTrack(track, hackrfPttStream));
        const offer = await pc.createOffer();
        await pc.setLocalDescription(offer);
        const answer = await hackrfTxBridge({
          action: "offer",
          sdp: pc.localDescription.sdp,
          type: pc.localDescription.type,
          frequency_hz: Math.round(Number(currentTunedFrequency()) || 0),
          mode: String(state.mode || "USB"),
        });
        await pc.setRemoteDescription(answer);

        const deadline = Date.now() + 5000;
        while (Date.now() < deadline) {
          const status = await hackrfTxBridge({ action: "status" });
          if (status.tx?.active) break;
          if (status.tx?.error) throw new Error(status.tx.error);
          await new Promise((resolve) => window.setTimeout(resolve, 150));
        }
        const status = await hackrfTxBridge({ action: "status" });
        if (!status.tx?.active)
          throw new Error("HackRF transmit did not start.");
        hackrfPttHeartbeat = window.setInterval(() => {
          hackrfTxBridge({ action: "heartbeat" }).catch(() => stopHackrfPtt());
        }, 2000);
      }

      window.addEventListener("message", async (event) => {
        if (
          event.source !== window.parent ||
          !event.data ||
          event.data.type !== "rigpi-hackrf-ptt"
        )
          return;
        const requestId = String(event.data.request_id || "");
        try {
          if (event.data.state) await startHackrfPtt();
          else await stopHackrfPtt();
          window.parent.postMessage(
            {
              type: "rigpi-hackrf-ptt-result",
              request_id: requestId,
              ok: true,
              state: event.data.state ? 1 : 0,
            },
            "*",
          );
        } catch (error) {
          await stopHackrfPtt();
          window.parent.postMessage(
            {
              type: "rigpi-hackrf-ptt-result",
              request_id: requestId,
              ok: false,
              state: 0,
              error: error?.message || "HackRF transmit failed.",
            },
            "*",
          );
        }
      });

