              _dragRafPending = false;
              buildSpectrumGrid();
              if (lastDisplay?.mags?.length) drawSpectrumBins(lastDisplay.mags);
            });
          }
          return;
        }
        e.preventDefault();
        cursorX = xCss; // red line tracks the dragged edge
        const span = Number(state.span);
        const wCss = rect.width;
        const pxPerHz = wCss / span;
        const cx = wCss / 2;
        const dragHz = (xCss - cx) / pxPerHz; // dragged edge in Hz from center
        const mode = String(state.mode || "").toUpperCase();

        if (mode === "CW") {
          // Independent edges: anchor is fixed, move only the dragged side
          if (_bwDragEdge === "right") {
            // rightHz = 700 + cwHighHz  →  cwHighHz = dragHz - 700
            state.cwHighHz = Math.max(
              50,
              Math.round(dragHz - (state.cwPitch || 600)),
            );
          } else {
            // leftHz = 700 - cwLowHz  →  cwLowHz = 700 - dragHz
            state.cwLowHz = Math.max(
              50,
              Math.round((state.cwPitch || 600) - dragHz),
            );
          }
          // bw = cwLowHz + cwHighHz (total width)
