        let _recInterval = null;

        function _recFmt(secs) {
          const m = Math.floor(secs / 60),
            s = secs % 60;
          return (m < 10 ? "0" : "") + m + ":" + (s < 10 ? "0" : "") + s;
        }

        function _recEscape(value) {
          return String(value || "").replace(
            /[&<>"']/g,
            (character) =>
              ({
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#39;",
              })[character],
          );
        }

        function _recRenderList(container, files, playerKind) {
