      // --- Server reset/restart button (available to all users, not admin-gated) ---
      document.getElementById("reset")?.addEventListener("click", () => {
        if (
          !confirm(
            "Restart the ELMER server for this instance?\n\nThe SDR panel will freeze for up to 30 seconds while it restarts.",
          )
        ) {
          return;
        }
        const btn = document.getElementById("reset");
        const origText = btn.textContent;
        btn.disabled = true;

        const startTime = Date.now();
        // Rough staged messages matching the known restart timeline:
        // ~0-1s stopping, ~1-6s systemd settle delay, ~6-9s device opening,
        // ~9s+ coming back online. Purely cosmetic — just keeps the wait
        // from feeling like nothing is happening.
        const stages = [
          { at: 0, text: "Stopping..." },
          { at: 1500, text: "Restarting service..." },
          { at: 6000, text: "Opening device..." },
          { at: 9000, text: "Almost there..." },
        ];
        let stageTimers = stages.map((s) =>
          setTimeout(() => {
            btn.textContent =
              s.text +
              " (" +
              Math.round((Date.now() - startTime) / 1000) +
              "s)";
          }, s.at),
        );
        const elapsedTimer = setInterval(() => {
          const secs = Math.round((Date.now() - startTime) / 1000);
          // Re-stamp whatever the current stage text is with fresh elapsed time
          const base = btn.textContent.replace(/\s*\(\d+s\)$/, "");
          btn.textContent = base + " (" + secs + "s)";
        }, 1000);

        fetch((window._sdrBase || "") + "/api/restart_mine", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ user: window._sdrUser || "admin" }),
        })
          .then((r) => r.json())
          .then((d) => {
            if (!d.ok) {
              stageTimers.forEach(clearTimeout);
              clearInterval(elapsedTimer);
              alert("Restart failed: " + (d.error || "unknown error"));
              btn.disabled = false;
              btn.textContent = origText;
              return;
            }
            console.log("[RESTART] triggered:", d.message);
            let attempts = 0;
            const poll = setInterval(() => {
              attempts++;
              fetch(
                (window._sdrBase || "") +
                  "/api/state?user=" +
                  (window._sdrUser || "admin") +
                  "&radio=1",
                { cache: "no-store" },
              )
                .then((r) => {
                  if (r.ok) {
                    clearInterval(poll);
                    stageTimers.forEach(clearTimeout);
                    clearInterval(elapsedTimer);
                    btn.textContent = "Back online, reloading...";
                    location.reload();
                  }
                })
                .catch(() => {}); // expected to fail while service is down
              if (attempts > 30) {
                clearInterval(poll);
                stageTimers.forEach(clearTimeout);
                clearInterval(elapsedTimer);
                btn.textContent = "Restart taking longer than expected...";
              }
            }, 1000);
          })
          .catch((e) => {
            stageTimers.forEach(clearTimeout);
            clearInterval(elapsedTimer);
            alert("Restart request failed: " + e.message);
            btn.disabled = false;
            btn.textContent = origText;
          });
      });

