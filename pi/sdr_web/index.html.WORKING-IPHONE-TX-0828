      function keyboardFibObjects() {
        return [...fib.intelligenceObjects]
          .filter((object) => Number.isFinite(object.defaultTune))
          .sort((a, b) => a.defaultTune - b.defaultTune);
      }

      function previewKeyboardFibObject(object) {
        if (!object || !fib.viewport) return;
        const rect = fibBar.getBoundingClientRect();
        const ratio =
          (object.defaultTune - fib.viewport.f0) / fib.viewport.spanHz;
        const x = rect.left + Math.max(0, Math.min(1, ratio)) * rect.width;
        showFibTargetAt(x, rect.top);
        fibBar.setAttribute(
          "aria-label",
          `${object.tooltip}. ${fmtFreqHz(object.start)} to ${fmtFreqHz(object.end)}. Press Enter or Space to tune ${fmtFreqHz(object.defaultTune)}.`,
