              <svg viewBox="0 0 80 80" style="width: 80px; height: 80px">
                <circle
                  cx="40"
                  cy="40"
                  r="34"
                  fill="none"
                  stroke="#1a2e1a"
                  stroke-width="6"
                />
                <circle
                  id="wiArc"
                  cx="40"
                  cy="40"
                  r="34"
                  fill="none"
                  stroke="#4f4"
                  stroke-width="6"
                  stroke-dasharray="0 214"
                  stroke-linecap="round"
                  transform="rotate(-90 40 40)"
                  style="transition: all 1s ease"
                />
              </svg>
              <div
                id="wiScore"
                style="
                  position: absolute;
                  top: 50%;
                  left: 50%;
                  transform: translate(-50%, -50%);
                  text-align: center;
                "
              >
                <div
                  style="
                    font-size: 22px;
                    font-weight: bold;
                    color: #9fe1cb;
                    line-height: 1;
                  "
                  id="wiScoreNum"
                >
                  --
                </div>
                <div style="font-size: 8px; color: #3a5a3a">/ 100</div>
              </div>
            </div>
            <!-- Grade + summary -->
            <div style="flex: 1">
              <div
                id="wiGrade"
                style="
                  font-size: 20px;
                  font-weight: bold;
                  color: #4f4;
                  margin-bottom: 4px;
                "
              >
                --
              </div>
              <div
                id="wiNarrative"
                style="
                  font-size: 11px;
                  color: #c8d8c8;
                  margin-bottom: 5px;
                  line-height: 1.5;
                  font-style: italic;
                  word-wrap: break-word;
                  white-space: normal;
                "
              ></div>
              <div
                id="wiPath"
                style="font-size: 10px; color: #5a8a5a; margin-bottom: 3px"
              ></div>
              <div id="wiSolar" style="font-size: 10px; color: #5a8a5a"></div>
            </div>
          </div>
          <!-- Factor bars -->
          <div style="padding: 10px 14px; border-bottom: 1px solid #1a2e1a">
            <div
              style="
                font-size: 9px;
                color: #7aaa7a;
                letter-spacing: 1px;
                margin-bottom: 6px;
              "
            >
              CONTRIBUTING FACTORS
            </div>
            <div
              id="wiFactors"
              style="display: flex; flex-direction: column; gap: 4px"
            ></div>
          </div>
          <!-- Bulletin snippet -->
          <div
            id="wiBulletinSection"
            style="
              padding: 10px 14px;
              border-bottom: 1px solid #1a2e1a;
              display: none;
            "
          >
            <div
              style="
                font-size: 9px;
                color: #7aaa7a;
                letter-spacing: 1px;
                margin-bottom: 4px;
              "
            >
              ARRL DX BULLETIN
            </div>
            <div
              id="wiBulletin"
              style="font-size: 10px; color: #38bdf8; line-height: 1.5"
            ></div>
            <div
              id="wiBulletinDate"
              style="font-size: 9px; color: #3a5a3a; margin-top: 3px"
            ></div>
          </div>
          <!-- PSKReporter -->
          <div
            id="wiPSKSection"
            style="
              padding: 10px 14px;
              border-bottom: 1px solid #1a2e1a;
              display: none;
            "
          >
            <div
              style="
                font-size: 9px;
                color: #7aaa7a;
                letter-spacing: 1px;
                margin-bottom: 4px;
              "
            >
              PSKREPORTER (last hour)
            </div>
            <div id="wiPSK" style="font-size: 10px; color: #38bdf8"></div>
          </div>
          <!-- QRZ info section -->
          <div
            id="wiQRZSection"
            style="
              padding: 10px 14px;
              border-bottom: 1px solid #1a2e1a;
              display: none;
            "
          >
            <div
              style="
                font-size: 9px;
                color: #7aaa7a;
                letter-spacing: 1px;
                margin-bottom: 6px;
              "
            >
              QRZ LOOKUP
            </div>
            <div style="display: flex; gap: 10px; align-items: flex-start">
              <img
                id="wiQRZPhoto"
                src=""
                alt=""
                style="
                  display: none;
                  width: 60px;
                  height: 60px;
                  object-fit: cover;
                  border-radius: 4px;
                  border: 1px solid #2a4a2a;
                  flex-shrink: 0;
                "
              />
              <div
                style="
                  flex: 1;
                  font-size: 10px;
                  color: #c8d8c8;
                  line-height: 1.6;
                "
              >
                <div
                  id="wiQRZName"
                  style="font-weight: bold; color: #9fe1cb"
                ></div>
                <div id="wiQRZAddr" style="color: #7aaa7a"></div>
                <div id="wiQRZConfirm" style="color: #38bdf8"></div>
                <div id="wiQRZURL" style="color: #5a8a5a"></div>
                <div
                  id="wiQRZEmail"
                  style="color: #5a8a5a; font-size: 10px"
                ></div>
              </div>
            </div>
          </div>
          <!-- Signal check section -->
          <div
            id="wiSignalSection"
            style="
              padding: 10px 14px;
              border-bottom: 1px solid #1a2e1a;
              display: none;
            "
          >
            <div
              style="
                font-size: 9px;
                color: #7aaa7a;
                letter-spacing: 1px;
                margin-bottom: 4px;
              "
            >
              SIGNAL CHECK
            </div>
            <div id="wiSignalResult" style="font-size: 11px; color: #4f4"></div>
          </div>
          <!-- Log lookup section -->
          <div
            id="wiLogSection"
            style="
              padding: 10px 14px;
              border-bottom: 1px solid #1a2e1a;
              display: none;
            "
          >
            <div
              style="
                font-size: 9px;
                color: #7aaa7a;
                letter-spacing: 1px;
                margin-bottom: 6px;
              "
            >
              LOG &amp; AWARDS
            </div>
            <div
              id="wiLogQSOs"
              style="font-size: 10px; color: #c8d8c8; margin-bottom: 6px"
            ></div>
            <div
              id="wiLogAwards"
              style="font-size: 10px; color: #38bdf8; line-height: 1.6"
            ></div>
          </div>
          <!-- DXSummit activity section -->
          <div
            id="wiActivitySection"
            style="
              padding: 10px 14px;
              border-bottom: 1px solid #1a2e1a;
              display: none;
            "
          >
            <div
              style="
                font-size: 9px;
                color: #7aaa7a;
                letter-spacing: 1px;
                margin-bottom: 4px;
              "
            >
              DXSUMMIT ACTIVITY
            </div>
            <div id="wiActivity" style="font-size: 10px; color: #38bdf8"></div>
          </div>
          <!-- Contests section -->
          <div
            id="wiContestsSection"
            style="
              padding: 10px 14px;
              border-bottom: 1px solid #1a2e1a;
              display: none;
            "
          >
            <div
              style="
                font-size: 9px;
                color: #7aaa7a;
                letter-spacing: 1px;
                margin-bottom: 4px;
              "
            >
              UPCOMING CONTESTS
            </div>
            <div
              id="wiContests"
              style="font-size: 10px; color: #c8d8c8; line-height: 1.7"
            ></div>
          </div>
        </div>
        <!-- end scrollable -->
        <!-- Scroll indicator -->
        <div
          id="wiScrollArrow"
          onclick="document.getElementById('wiScrollable').scrollBy({top:120,behavior:'smooth'})"
          style="
            display: none;
            text-align: center;
            padding: 3px;
            background: linear-gradient(transparent, #0a120a);
            color: #38bdf8;
            font-size: 14px;
            cursor: pointer;
            flex-shrink: 0;
          "
        >
          ▼
        </div>
        <!-- Footer - sticky -->
        <div
          style="
            padding: 8px 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid #1a2e1a;
            background: #080e08;
            flex-shrink: 0;
          "
        >
          <div id="wiTimestamp" style="font-size: 9px; color: #3a5a3a"></div>
          <div style="display: flex; gap: 6px">
            <button
              id="wiCopyBtn"
              onclick="window._wiViewFormatted()"
              style="
                font-size: 10px;
                padding: 3px 10px;
                background: #0a1a0a;
                color: #38bdf8;
                border: 0.5px solid #2a4a2a;
                border-radius: 3px;
                cursor: pointer;
              "
            >
              &#128196; Copy / View
            </button>
            <button
              onclick="document.getElementById('wiModal').style.display='none'"
              style="
                font-size: 10px;
                padding: 3px 14px;
                background: #1a2e1a;
                color: #9fe1cb;
                border: 0.5px solid #2a4a2a;
                border-radius: 3px;
                cursor: pointer;
              "
            >
              Close
            </button>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
