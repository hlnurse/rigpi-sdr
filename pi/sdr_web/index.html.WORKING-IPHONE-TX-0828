    <script>
      // ── Messaging system ─────────────────────────────────────────────────────
      (function () {
        var _msgPending = []; // unread message objects
        var _msgSeen = {}; // id -> true (already shown as toast)
        var _msgPanelOpen = false;
        var _msgIsAdmin = false;
        var _msgUser = "";

        // Colours per type
        var TYPE_COLOR = { alert: "#f55", info: "#0af", message: "#4f4" };

        function _fmt(ts) {
          var d = new Date(ts * 1000);
          return d.toLocaleTimeString([], {
            hour: "2-digit",
            minute: "2-digit",
          });
        }

        // ── Toggle panel ────────────────────────────────────────────────────────
        window._msgRefreshUsers = function () {
          var sel = document.getElementById("msgTo");
          if (!sel) return;
          fetch((window._sdrBase || "") + "/api/active_users")
            .then(function (r) {
              return r.json();
            })
            .then(function (d) {
              if (!d.users) return;
              var current = sel.value;
              sel.innerHTML = '<option value="all">→ All Users</option>';
              d.users.forEach(function (u) {
                var o = document.createElement("option");
                o.value = u;
                o.textContent = "→ " + u;
                sel.appendChild(o);
              });
              sel.value = current || "all";
            })
            .catch(function () {});
        };

        window._msgTogglePanel = function () {
          var p = document.getElementById("msgPanel");
          _msgPanelOpen = !_msgPanelOpen;
          if (_msgPanelOpen) {
            p.classList.add("open");
            _msgRenderLog();
            window._msgRefreshUsers();
            _msgUpdateBadge(0);
            // Ack all visible
            var ids = _msgPending.map((m) => m.id);
            if (ids.length) _msgAck(ids);
          } else {
            p.classList.remove("open");
          }
        };

        // ── Clear all (local) ───────────────────────────────────────────────────
        window._msgClearAll = function () {
          var ids = _msgPending.map((m) => m.id);
          _msgPending = [];
          _msgSeen = {};
          document.getElementById("msgLog").innerHTML = "";
          _msgUpdateBadge(0);
          if (ids.length) _msgAck(ids);
        };

        // ── Ack on server ───────────────────────────────────────────────────────
        function _msgAck(ids) {
          if (!_msgUser || !ids.length) return;
          fetch(
            (window._sdrBase || "") +
              "/api/msg/ack?user=" +
              encodeURIComponent(_msgUser),
            {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ ids: ids }),
            },
          ).catch(function () {});
        }

        // ── Update envelope badge ───────────────────────────────────────────────
        function _msgUpdateBadge(n) {
          var env = document.getElementById("msgEnvelopeBtn");
          var badge = document.getElementById("msgBadge");
          if (!env || !badge) return;
          if (n > 0) {
            env.classList.add("has-unread");
            badge.style.display = "inline-block";
            badge.textContent = n > 9 ? "9+" : String(n);
          } else {
            env.classList.remove("has-unread");
            badge.style.display = "none";
          }
        }

        // ── Render message log in panel ─────────────────────────────────────────
        function _msgRenderLog() {
          var log = document.getElementById("msgLog");
          if (!log) return;
          log.innerHTML = "";
          if (!_msgPending.length) {
            log.innerHTML =
              '<div style="color:#555;font-size:10px;padding:8px;text-align:center;">No messages</div>';
            return;
          }
          _msgPending.forEach(function (m) {
            var div = document.createElement("div");
            div.className = "msg-item " + (m.type || "message");
            var to_str = m.to === "all" ? "→ ALL" : "→ " + m.to.toUpperCase();
            div.innerHTML =
              '<div class="msg-meta">' +
              _fmt(m.ts) +
              " &nbsp; <b>" +
              m.from +
              "</b> " +
              to_str +
              "</div>" +
              "<div>" +
              m.text.replace(/</g, "&lt;") +
              "</div>";
            // Reply button — anyone can reply
            if (m.to === _msgUser || m.to === "all") {
              var btn = document.createElement("button");
              btn.style.cssText =
                "font-size:9px;margin-top:3px;padding:1px 5px;background:#1a2a1a;color:#4f4;border:1px solid #4f4;border-radius:2px;cursor:pointer;";
              btn.textContent = "Reply";
              btn.onclick = function () {
                var toSel = document.getElementById("msgTo");
                if (toSel) {
                  // Add option if not exists
                  var exists = Array.from(toSel.options).find(function (o) {
                    return o.value === m.from;
                  });
                  if (!exists) {
                    var opt = document.createElement("option");
                    opt.value = m.from;
                    opt.textContent = "→ " + m.from;
                    toSel.appendChild(opt);
                  }
                  toSel.value = m.from;
                }
                document.getElementById("msgText").focus();
              };
              div.appendChild(btn);
            }
            log.appendChild(div);
          });
          log.scrollTop = log.scrollHeight;
        }

        // ── Show toast for incoming message ─────────────────────────────────────
        function _msgShowToast(m) {
          // Remove old toasts of same type if stacking up
          var old = document.querySelectorAll(".msg-toast");
          if (old.length >= 3) old[0].remove();

          var t = document.createElement("div");
          t.className = "msg-toast " + (m.type || "message");
          t.style.bottom = 48 + old.length * 70 + "px";
          t.innerHTML =
            "<b>" +
            m.from +
            ":</b> " +
            m.text.replace(/</g, "&lt;") +
            '<div style="font-size:9px;color:#888;margin-top:2px;">' +
            _fmt(m.ts) +
            " — click to open</div>";
          t.onclick = function () {
            t.remove();
            window._msgTogglePanel();
          };
          document.body.appendChild(t);

          // Auto-dismiss: alert=0 (manual), info=10s, message=20s
          var delay =
            m.type === "alert" ? 0 : m.type === "info" ? 10000 : 20000;
          if (delay)
            setTimeout(function () {
              if (t.parentNode) t.remove();
            }, delay);
        }

        // ── Poll for new messages ────────────────────────────────────────────────
        window._msgPoll = function (user, isAdmin) {
          _msgUser = user;
          _msgIsAdmin = isAdmin;
          // Update To dropdown for admin
          var toSel = document.getElementById("msgTo");
          var typeSel = document.getElementById("msgType");
          // All users can send to all or specific user
          if (
            toSel &&
            !Array.from(toSel.options).find(function (o) {
              return o.value === "all";
            })
          ) {
            var opt = document.createElement("option");
            opt.value = "all";
            opt.textContent = "→ All Users";
            toSel.insertBefore(opt, toSel.firstChild);
            toSel.value = "all";
          }
          if (typeSel) typeSel.style.display = isAdmin ? "" : "none"; // type selector admin-only

          window._msgRefreshUsers();
          fetch(
            (window._sdrBase || "") +
              "/api/msg/poll?user=" +
              encodeURIComponent(user),
          )
            .then(function (r) {
              return r.json();
            })
            .then(function (d) {
              if (!d.messages) return;
              var newMsgs = [];
              d.messages.forEach(function (m) {
                if (!_msgSeen[m.id]) {
                  _msgSeen[m.id] = true;
                  _msgPending.push(m);
                  newMsgs.push(m);
                }
              });
              if (newMsgs.length) {
                _msgUpdateBadge(_msgPending.length);
                if (!_msgPanelOpen) {
                  newMsgs.forEach(function (m) {
                    _msgShowToast(m);
                  });
                } else {
                  _msgRenderLog();
                  _msgAck(
                    newMsgs.map(function (m) {
                      return m.id;
                    }),
                  );
                }
              }
            })
            .catch(function () {});
        };

        // ── Send message ─────────────────────────────────────────────────────────
        window._msgSend = function () {
          var text = (document.getElementById("msgText").value || "").trim();
          var to = document.getElementById("msgTo").value || "all";
          var type =
            (document.getElementById("msgType") || { value: "message" })
              .value || "message";
          if (!text || !_msgUser) return;
          fetch(
            (window._sdrBase || "") +
              "/api/msg/send?user=" +
              encodeURIComponent(_msgUser),
            {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ to: to, text: text, type: type }),
            },
          )
            .then(function (r) {
              return r.json();
            })
            .then(function (d) {
              if (d.ok) {
                document.getElementById("msgText").value = "";
                // Show sent confirmation locally
                var log = document.getElementById("msgLog");
                if (log) {
                  var div = document.createElement("div");
                  div.className = "msg-item info";
                  div.style.opacity = "0.6";
                  div.innerHTML =
                    '<div class="msg-meta">Sent → ' +
                    to.toUpperCase() +
                    "</div><div>" +
                    text.replace(/</g, "&lt;") +
                    "</div>";
                  log.appendChild(div);
                  log.scrollTop = log.scrollHeight;
                }
              }
            })
            .catch(function () {});
        };

        // Enter key sends
        document.addEventListener("DOMContentLoaded", function () {
          var ta = document.getElementById("msgText");
          if (ta)
            ta.addEventListener("keydown", function (e) {
              if (e.key === "Enter" && !e.shiftKey) {
                e.preventDefault();
                window._msgSend();
              }
            });
        });
      })();
    </script>

