          const edge2 = _bwHitEdge(xCss);
          const rect3 = spCanvas.getBoundingClientRect();
          const nearCtr = Math.abs(xCss - rect3.width / 2) < 8;
          spCanvas.style.cursor = edge2
            ? "ew-resize"
            : nearCtr
              ? "grab"
              : "crosshair";
          return;
        }
        if (freqDragging) {
          e.preventDefault();
          cursorX = xCss;
          const f = xToFreqHzCss(xCss, lastDisplay?.freqs, spCanvas);
          if (f !== null) {
