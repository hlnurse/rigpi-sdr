      // ---- AUDIO WS SETUP (NEW) ----
      // ---- AUDIO WS SETUP (JITTER BUFFER + ScriptProcessor) ----
      const AUDIO_SR = 48000;
      const BLOCK_SAMPLES = 2048;
      const START_THRESHOLD = Math.floor(AUDIO_SR * 0.5); // 500 ms prime
      //     const TARGET_FILL = Math.floor(AUDIO_SR * 0.35); // 350 ms steady-state

      const MAX_FILL = Math.floor(AUDIO_SR * 1.5); // safety (optional)
      let playing = false;
