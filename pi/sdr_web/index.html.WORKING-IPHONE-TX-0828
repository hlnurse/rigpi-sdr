        if (audioCtx) {
          audioCtx.close();
          audioCtx = null;
        }

        if (audioPC) {
          try {
            audioPC.getReceivers().forEach((r) => r.track && r.track.stop());
          } catch (e) {}

          try {
            await audioPC.close();
          } catch (e) {}

          audioPC = null;
