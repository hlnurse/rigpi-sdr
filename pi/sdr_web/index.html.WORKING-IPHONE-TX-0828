      function drawAudioSpectrum() {
        const bins = analyser.frequencyBinCount;

        if (!scopeBuf || scopeBuf.length !== bins) {
          scopeBuf = new Uint8Array(bins);
        }

        analyser.getByteFrequencyData(scopeBuf);

        const w = scopeCanvas.width;
        const h = scopeCanvas.height;
        const g1 = scopeCtx.createLinearGradient(0, 0, 0, h);
        g1.addColorStop(0, "#000");
        g1.addColorStop(1, "#0010FF");

        scopeCtx.fillStyle = g1;
        scopeCtx.fillRect(0, 0, w, h);

        // phosphor fade
        scopeCtx.fillStyle = "rgba(0,0,0,0.15)";
        scopeCtx.fillRect(0, 0, w, h);

        const bars = 64; // Flex style coarse bins
        const step = Math.floor(bins / bars);

        for (let i = 0; i < bars; i++) {
          let max = 0;

          for (let j = 0; j < step; j++) {
            const v = scopeBuf[i * step + j];
            if (v > max) max = v;
          }

          const level = Math.pow(max / 255, 1.8);
          // logarithmic boost (better for SDR audio)
          //          const level = Math.pow(v, 1.8);

          const x = (i / bars) * w;
          const barWidth = w / bars;

          const y = level * h;

          // color gradient
          const r = Math.min(255, level * 400);
          const g = 255;
          const b = 80;

          scopeCtx.fillStyle = `rgb(${r},${g},${b})`;

          scopeCtx.fillRect(x, h - y, barWidth - 1, y);
        }
      }
      function drawScope() {
        if (!analyser) {
          requestAnimationFrame(drawScope);
          return;
        }

        if (audioViewMode === "spectrum") {
          drawAudioSpectrum();
          requestAnimationFrame(drawScope);
          return;
        }
        if (!scopeBuf || scopeBuf.length !== analyser.fftSize) {
          scopeBuf = new Uint8Array(analyser.fftSize);
        }

        analyser.getByteTimeDomainData(scopeBuf);

        const w = scopeCanvas.width;
        const h = scopeCanvas.height;

        // phosphor decay
        scopeCtx.globalCompositeOperation = "source-over";
        scopeCtx.fillStyle = "rgba(0,0,0,0.08)";
        scopeCtx.fillRect(0, 0, w, h);

        // bright trace blend
        scopeCtx.globalCompositeOperation = "lighter";
        scopeCtx.shadowColor = "#00ff66";
        scopeCtx.shadowBlur = 6;
        scopeCtx.lineWidth = 1.5;
        scopeCtx.beginPath();
        scopeCtx.moveTo(0, h / 2);
        scopeCtx.lineTo(w, h / 2);

        // ----- FIND TRIGGER -----
        let start = 0;

        for (let i = 1; i < scopeBuf.length; i++) {
          if (scopeBuf[i - 1] < 128 && scopeBuf[i] >= 128) {
            start = i;
            break;
          }
        }
        scopeCtx.shadowBlur = 0;
        scopeCtx.globalCompositeOperation = "source-over";
        // ----- DRAW -----
        scopeCtx.strokeStyle = "#00ff00";
        scopeCtx.beginPath();

        const samples = scopeBuf.length;
        for (let i = 0; i < samples; i++) {
          const idx = (start + i) % samples;

          const x = (i / samples) * w;
          const y = h / 2 + (scopeBuf[idx] - 128) * (h / 256);
          if (i === 0) scopeCtx.moveTo(x, y);
          else scopeCtx.lineTo(x, y);
        }
        scopeCtx.stroke();
        requestAnimationFrame(drawScope);
      }
