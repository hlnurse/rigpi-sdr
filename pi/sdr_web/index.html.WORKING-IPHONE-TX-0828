      function onFreqMouseDown(e) {
        // Resolve the clicked digit span (walk up from text node if needed)
        let el = e.target;
        if (el.nodeType === Node.TEXT_NODE) el = el.parentElement;
        // If click landed on container or sep, find closest digit by X position
        if (!el.classList.contains("digit")) {
          const digits = [...freqLED.querySelectorAll(".digit")];
          if (!digits.length) return;
          let best = digits[0],
            bestDist = Infinity;
          for (const d of digits) {
            const r = d.getBoundingClientRect();
            const cx = (r.left + r.right) / 2;
            const dist = Math.abs(e.clientX - cx);
            if (dist < bestDist) {
              bestDist = dist;
              best = d;
            }
          }
          el = best;
        }

        const clickedIdx = Number(el.dataset.idx);
        freqLED.focus();
        freqEditing = true;

        if (clickedIdx !== activeDigit) {
          // First click — just select
          activeDigit = clickedIdx;
          drawCursor();
          return;
        }

        // Second click on already-selected digit
        // Use the LED container height for reliable upper/lower split
        const ledRect = freqLED.getBoundingClientRect();
        const relY = e.clientY - ledRect.top;
        const delta = relY < ledRect.height / 2 ? 1 : -1;

        // Use Hz arithmetic for ripple carry — place value of digit idx 0..8
        // idx 0 = 100MHz, idx 1 = 10MHz, ... idx 8 = 1Hz
        const placeValue = Math.pow(10, 8 - activeDigit);
        const baseHz = currentTunedFrequency();
        if (!Number.isFinite(baseHz)) return;
        const newHz = Math.max(1, Math.round(baseHz) + delta * placeValue);
