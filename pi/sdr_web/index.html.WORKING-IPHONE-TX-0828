      function updateDeviceDropdown(d) {
        const sel = document.getElementById("deviceSelect");
        if (!sel) return;
        if (!d.available_devices || !d.available_devices.length) {
          // Don't touch the select on a transient empty list (e.g. mid-restart,
          // before the server has finished enumerating). Returning here used to
          // leave the dropdown showing only the lazily-created "__kiwi__" Remote
          // SDR placeholder with no real devices, if that code path happened to
          // run first. As a safety net, mark the list as stale so the next poll
          // that DOES have devices is guaranteed to do a full rebuild rather than
          // assuming nothing changed.
          lastDeviceList = "";
          return;
        }
        // Clear switching flag when server confirms driver change complete
        if (
          window._deviceSwitching &&
          d.device_driver === _activeDeviceDriver &&
          (d.device_serial || "") === _activeDeviceSerial
        ) {
          window._deviceSwitching = false;
        }
        // Clear switching flag when server confirms driver change complete
        if (
          window._deviceSwitching &&
          d.device_driver === _activeDeviceDriver &&
          (d.device_serial || "") === _activeDeviceSerial
        ) {
          window._deviceSwitching = false;
        }
        if (window._deviceSwitching) return;

        // Always sync active device from server state
        // But don't update selection when OWRX/KiwiSDR is active (would select "fake")
        const _remoteActive = d.owrx_active || d.kiwi_ok;
        if (d.device_driver && !_remoteActive) {
          _activeDeviceDriver = d.device_driver;
          _activeDeviceSerial = d.device_serial || "";
          _activeDeviceRemote = d.device_remote || "";
        } else if (d.device_driver && d.device_driver !== "fake") {
          // Save real driver even when remote active (for restore on disconnect)
          _activeDeviceDriver = d.device_driver;
          _activeDeviceSerial = d.device_serial || "";
        }

        // Ownership can change while the physical device enumeration remains
        // identical (for example when sdr_web@8005 stops). Include live claims
        // so the dropdown rebuilds instead of retaining a stale "in use" label.
        const key = JSON.stringify({
          devices: d.available_devices,
          taken: d.taken_devices || [],
        });
        if (key === lastDeviceList) {
          // List unchanged — ensure correct selection (skip when remote active)
          if (_remoteActive) return;
          for (const opt of sel.options) {
            try {
              const v = JSON.parse(opt.value);
              if (!v.port) {
                opt.selected = _activeDeviceSerial
                  ? (v.serial || "") === _activeDeviceSerial
                  : v.driver === _activeDeviceDriver;
              } else {
                opt.selected = false;
              }
            } catch {}
          }
          return;
        }

        // Never replace an open/focused native select. Replacing its options
        // closes the menu and makes the values appear to jump under the user.
        // Defer the newest state until the control loses focus.
        if (document.activeElement === sel) {
          window._deferredDeviceDropdownState = d;
          return;
        }

        // Mark the list as being built before the asynchronous ownership
        // lookup. State polling runs every second; waiting until the response
        // arrived allowed several overlapping rebuilds to race each other.
        lastDeviceList = key;
        const buildGeneration =
