      // Wheel routing for the Frequency Intelligence Bar.
      // Shift+wheel tunes by the highlighted LED digit; plain wheel changes bandwidth.
      // Trailing macOS momentum events that lose Shift are ignored rather than
      // being reinterpreted as bandwidth changes.
      let fibShiftHeld = false;
      let fibLastShiftWheelAt = 0;
      let fibWheelTuneHz = NaN;

      window.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Shift") fibShiftHeld = true;
        },
        true,
      );
      window.addEventListener(
        "keyup",
        (event) => {
          if (event.key === "Shift") fibShiftHeld = false;
        },
        true,
      );
