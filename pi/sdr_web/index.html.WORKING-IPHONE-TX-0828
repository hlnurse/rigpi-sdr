        } else {
          bar.style.background = "#ff3030";
          bar.style.boxShadow = "0 0 8px rgba(255,0,0,0.8)";
        }
        const now = performance.now();

        if (vuSmooth > vuPeak) {
          vuPeak = vuSmooth;
          peakTimestamp = now;
        } else {
          if (now - peakTimestamp > PEAK_HOLD_TIME) {
            vuPeak = Math.max(vuSmooth, vuPeak - 0.004);
