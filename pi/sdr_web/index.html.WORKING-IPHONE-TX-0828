        const u = encodeURIComponent(window._sdrUser || "admin");
        const c = encodeURIComponent(window._sdrCallsign || "ADMIN");
        // Build path — use sdr base path to route to correct instance via nginx
        var _basePath = window._sdrBase || "";
        // If no base path, use direct port connection
        var _wsHost = host;
        if (!_basePath && window._sdrRadio && window._sdrRadio > 1) {
          // Direct port connection for non-proxy access
          _wsHost = location.hostname + ":" + (8000 + window._sdrRadio);
        }
        return (
          proto + _wsHost + _basePath + "/ws/spectrum?user=" + u + "&call=" + c
        );
      }
      const tabs = document.getElementById("panelTabs");

      document.getElementById("tabScrollLeft").onclick = () => {
        tabs.scrollBy({ left: -150, behavior: "smooth" });
      };

      document.getElementById("tabScrollRight").onclick = () => {
        tabs.scrollBy({ left: 150, behavior: "smooth" });
      };

      // ---- FT8 Tab Logic ----
      let _ft8Spots = [];
      let _ft8CqOnly = false;
      let _ft8PollTimer = null;
      let _ft8TotalDecodes = 0;

      function ft8DialHz(band) {
        const DIAL = {
          160: 1.84e6,
          80: 3.573e6,
          60: 5.357e6,
          40: 7.074e6,
          30: 10.136e6,
          20: 14.074e6,
          17: 18.1e6,
          15: 21.074e6,
          12: 24.915e6,
          10: 28.074e6,
          6: 50.313e6,
          2: 144.174e6,
        };
        const key = String(band || "")
          .trim()
          .toLowerCase()
          .replace(/m$/, "");
        return DIAL[key] || null;
      }

      // Snap an arbitrary frequency (Hz) to its FT8/FT4 sub-band DIAL base.
      // Cluster & decoder FT8 spots report the signal's actual frequency
      // (dial + audio offset, ~0-3 kHz above the dial); click-to-tune must go
      // to the dial base, not the offset frequency. Returns null if the freq
      // is not within a known FT8 sub-band, so non-FT8 spots are unaffected.
      function ft8SnapDialHz(freqHz) {
        const DIALS = [
          1.84e6, 3.573e6, 5.357e6, 7.074e6, 10.136e6, 14.074e6, 18.1e6,
          21.074e6, 24.915e6, 28.074e6, 50.313e6, 144.174e6,
        ];
        for (const d of DIALS) {
          if (freqHz >= d - 500 && freqHz <= d + 3500) return d;
        }
        return null;
      }

      function ft8RenderTable() {
        const tbody = document.getElementById("ft8TableBody");
        const cqOnly = document.getElementById("ft8CqOnly")?.checked;
        if (!tbody) return;
        const scrollBox = tbody.closest("div"); // the overflow:auto wrapper
        const wasNearBottom = scrollBox
          ? scrollBox.scrollHeight -
              scrollBox.scrollTop -
              scrollBox.clientHeight <
            40
          : true;
        const spots = cqOnly
          ? _ft8Spots.filter((s) => s.msg && s.msg.startsWith("CQ"))
          : _ft8Spots;
        const readableTime = (raw) => {
          const digits = String(raw || "").replace(/\D/g, "");
          if (digits.length >= 6)
            return `${digits.slice(0, 2)}:${digits.slice(2, 4)}:${digits.slice(4, 6)}`;
          if (digits.length >= 4)
            return `${digits.slice(0, 2)}:${digits.slice(2, 4)}`;
          return String(raw || "");
        };
        tbody.innerHTML = "";
        for (const s of spots.slice().reverse()) {
          const tr = document.createElement("tr");
          tr.style.cssText = "border-bottom:1px solid #111;cursor:pointer;";
          tr.onmouseenter = () => (tr.style.background = "#0d2a0d");
          tr.onmouseleave = () => (tr.style.background = "");
          const snrColor =
            s.snr == null
              ? "#555"
              : s.snr >= -5
                ? "#4f4"
                : s.snr >= -12
                  ? "#aa4"
                  : "#888";
          const snrTxt = s.snr == null ? "" : (s.snr >= 0 ? "+" : "") + s.snr;
          const dialHz = Number(s.dial_hz) || ft8DialHz(s.band);
          const audioKhz = s.audio_hz ? (s.audio_hz / 1000).toFixed(2) : "";
          const displayTime = readableTime(s.webtime);
          const tipParts = [
            displayTime,
            snrTxt,
            s.dx_call || "",
            s.de_call || "",
            s.grid || "",
            s.msg || "",
          ];
          tr.title = tipParts.filter(Boolean).join("  ");
          tr.innerHTML = `
      <td style="padding:2px 6px;color:#ddd;font-size:12px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;">${displayTime}</td>
      <td style="padding:2px 4px;text-align:right;color:${snrColor};white-space:nowrap;">${snrTxt}</td>
      <td style="padding:2px 4px;color:#4af;font-weight:600;white-space:nowrap;">${s.dx_call || ""}</td>
      <td style="padding:2px 4px;color:#aaa;white-space:nowrap;">${s.de_call || ""}</td>
      <td style="padding:2px 4px;color:#6a6;white-space:nowrap;">${s.grid || ""}</td>
      <td style="padding:2px 4px;text-align:right;color:#888;white-space:nowrap;">${s.band ? s.band : ""}</td>
      <td style="padding:2px 4px;color:#789;white-space:nowrap;">${s.msg || ""}</td>
       `;
          // Click to tune to dial freq, and populate RigPi's DX Call box + WI lookup
          if (dialHz) {
            tr.onclick = () => {
              sendTune(dialHz);
              const audioOffset = s.freq_hz ? s.freq_hz - dialHz : 0;
              window._ft8AudioMarker =
                audioOffset > 0 && audioOffset < 4000
                  ? { freq: dialHz + audioOffset, audioHz: audioOffset }
                  : null;
              if (
                typeof drawSpectrumBins === "function" &&
                lastDisplay?.mags?.length
              )
                drawSpectrumBins(lastDisplay.mags);
              if (s.dx_call) {
                const dxUpper = s.dx_call.toUpperCase();
                window.parent.postMessage(
                  { type: "elmrTune", dx: dxUpper },
                  "*",
                );
                if (typeof window._elmrShowWI === "function") {
                  window._elmrShowWI(dxUpper, s.grid || "", 0, null);
                }
                window._elmrWIFreq = s.freq_hz || dialHz;
                var sigBtn = document.getElementById("elmrWISigBtn");
                if (sigBtn) sigBtn.style.display = "";
                var sigStatus = document.getElementById("elmrWISigStatus");
                if (sigStatus) {
                  sigStatus.textContent = "";
                }
              }
            };
          }
          tbody.appendChild(tr);
        }
        if (wasNearBottom && scrollBox) {
          scrollBox.scrollTop = scrollBox.scrollHeight;
        }
      }

      async function ft8Poll() {
        try {
          const r = await fetch((window._sdrBase || "") + "/api/ft8/spots");
          if (!r.ok) return;
          const d = await r.json();
          if (d.spots) {
            _ft8Spots = d.spots;
            _ft8TotalDecodes = d.total_decodes || _ft8Spots.length;
            // Merge FT8 spots into map (_elmrSpots) using grid->lat/lon
            if (
              window._elmrSpots &&
              typeof window._grid2latlon === "function"
            ) {
              const ft8pins = [];
              for (const s of _ft8Spots) {
                if (!s.grid || s.grid.length < 4) continue;
                const ll = window._grid2latlon(s.grid);
                if (!ll) continue;
                ft8pins.push({
                  DX: s.dx_call || "",
                  Spotter: s.de_call || "",
                  Frequency: Number(s.freq_hz) || ft8DialHz(s.band) || 0,
                  DialFrequency: Number(s.dial_hz) || ft8DialHz(s.band) || 0,
                  Band: s.band || "",
                  Mode: s.mode || "FT8",
                  Note: s.msg || "",
                  Latitude: ll.lat,
                  Longitude: ll.lon,
                  Country: "",
                  Continent: "",
                  DXCC: "",
                  _ft8: true,
                });
              }
              window._elmrSpots = window._elmrSpots
                .filter((s) => !s._ft8)
                .concat(ft8pins);
            }
          }
          // Update status bar
          const dot = document.getElementById("ft8StatusDot");
          const txt = document.getElementById("ft8StatusText");
          const cnt = document.getElementById("ft8DecodeCount");
          const selector = document.getElementById("ft8ModeSelect");
          if (
            selector &&
            d.status?.selection &&
            document.activeElement !== selector
          )
            selector.value = d.status.selection;
          if (d.status && d.status.running) {
            if (dot) dot.style.background = "#4f4";
            if (txt)
              txt.textContent = `${d.status.mode || "FT8"} ${d.status.band || ""} ${d.status.dial_hz ? (d.status.dial_hz / 1e6).toFixed(3) + " MHz" : ""}`;
          } else {
            if (dot) dot.style.background = "#444";
            if (txt) txt.textContent = "FT8 decoder idle";
          }
          if (cnt)
            cnt.textContent = _ft8Spots.length
              ? `${_ft8Spots.length} spots`
              : "";
          ft8RenderTable();
        } catch (e) {}
      }

      async function ft8SetMode(selection) {
        const selector = document.getElementById("ft8ModeSelect");
        if (selector) selector.disabled = true;
        try {
          const response = await fetch(
            (window._sdrBase || "") + "/api/ft8/control",
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "X-Requested-With": "RigPi-SDR",
              },
              body: JSON.stringify({
                selection,
                freq_hz: currentTunedFrequency(),
              }),
            },
          );
          const result = await response.json().catch(() => ({}));
          if (!response.ok || !result.ok)
            throw new Error(result.error || "Decoder control failed");
          await ft8Poll();
        } catch (error) {
          const txt = document.getElementById("ft8StatusText");
          if (txt) txt.textContent = error.message;
        } finally {
          if (selector) selector.disabled = false;
        }
      }

      function ft8StartPolling() {
        ft8Poll();
        _ft8PollTimer = setInterval(ft8Poll, 5000);
      }
      function ft8StopPolling() {
        if (_ft8PollTimer) {
          clearInterval(_ft8PollTimer);
          _ft8PollTimer = null;
        }
      }

