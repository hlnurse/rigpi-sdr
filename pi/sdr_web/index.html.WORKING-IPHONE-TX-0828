        });

        // ── public feed: called by drawWaterfallRow() ────────────────────────────
        window.wf3dFeedRow = function (bins, floor, ceil) {
          if (!wf3dActive) return;
          const slot = rowHead * WF3D_COLS;
          const blen = bins.length;
