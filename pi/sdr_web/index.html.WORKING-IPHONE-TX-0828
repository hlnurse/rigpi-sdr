      function tuneFibTarget(object, ratio, selectedAction = null) {
        const clickedFrequency = fib.frequencyAtRatio(ratio);
        const fibAction = selectedAction || object?.action;
        const tuneFrequency =
          fibAction && Number.isFinite(fibAction.frequency)
            ? fibAction.frequency
            : clickedFrequency;
        if (!Number.isFinite(tuneFrequency)) return;

        if (
          fibAction?.kind === "panel-memory" &&
          Number.isInteger(fibAction.slot)
        ) {
          tuneStoredMemory(fibAction.slot);
        } else {
          // Raw FIB clicks remain frequency-only. Intelligence objects may also
          // define mode and bandwidth; apply those as one logical action.
          sendTune(tuneFrequency);
          if (fibAction?.mode) {
            state.mode = fibAction.mode;
            state.bw =
              fibAction.bandwidth > 0
                ? fibAction.bandwidth
                : getDefaultBW(fibAction.mode);
            modeEditing = true;
