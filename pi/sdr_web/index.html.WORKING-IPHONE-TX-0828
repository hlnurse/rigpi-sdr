        });
      });
      function drawSpectrumBins(bins) {
        if (!bins || bins.length < 2) return;

        const rect = spCanvas.getBoundingClientRect();
        const wCss = rect.width;
        const hCss = rect.height;
        if (wCss <= 0 || hCss <= 0) return;

        // Clear + draw cached grid
        spCtx.clearRect(0, 0, wCss, hCss);
        if (spGridImage && !window._mapModeActive) {
          spCtx.drawImage(spGridImage, 0, 0, wCss, hCss);
        }

        const floor = Number(state.floor);
        const ceil = floor + 80;

        const step = Math.max(1, Math.ceil(bins.length / wCss));

        // --------- BUILD PATH ---------
        // ELMER threshold line
        if (typeof state !== "undefined" && state.floor) {
          const effThresh = state.floor + 20;
          const floor = Number(state.floor);
          const ceil = floor + 80;
          let t = (effThresh - floor) / (ceil - floor);
          t = Math.max(0, Math.min(1, t));
          const thY = hCss - t * hCss;
          spCtx.save();
          spCtx.strokeStyle = "rgba(216,90,48,0.7)";
          spCtx.lineWidth = 1;
          spCtx.setLineDash([4, 4]);
          spCtx.beginPath();
          spCtx.moveTo(0, thY);
          spCtx.lineTo(wCss, thY);
          spCtx.stroke();
          spCtx.setLineDash([]);
          spCtx.restore();
        }
        const points = [];
        // FFT data can only be sliced on whole bins, but tuning steps are often
        // smaller than one bin. Translate the plotted trace by the fractional
        // center difference so the spectrum follows the orange line every step.
        const slicedCenterHz = Number(state._slicedCenter);
        const visibleCenterHz = Number(state.displayCenter);
        const visibleSpanHz = Number(state.span);
        const fractionalShiftPx =
          Number.isFinite(slicedCenterHz) &&
          Number.isFinite(visibleCenterHz) &&
          Number.isFinite(visibleSpanHz) &&
          visibleSpanHz > 0
            ? ((slicedCenterHz - visibleCenterHz) / visibleSpanHz) * wCss
            : 0;

        for (let i = 0; i < bins.length; i += step) {
          const x = (i / (bins.length - 1)) * wCss + fractionalShiftPx;

          let t = (bins[i] - floor) / (ceil - floor);
          t = Math.max(0, Math.min(1, t));

          points.push({ x, y: hCss - t * hCss, t });
        }

        // The translated FFT occupies only this interval.  Do not extend the
        // final live bin into uncovered display space; that made the dead-air
        // area inherit the last bin and visibly bobble.
        const liveLeftPx = Math.max(0, Math.min(wCss, fractionalShiftPx));
        const liveRightPx = Math.max(
          0,
          Math.min(wCss, wCss + fractionalShiftPx),
        );

        // Clip every spectrum fill and trace operation to the actual sampled
        // interval.  Out-of-band display space is painted separately below.
        spCtx.save();
        spCtx.beginPath();
        spCtx.rect(liveLeftPx, 0, Math.max(0, liveRightPx - liveLeftPx), hCss);
        spCtx.clip();

        // --------- FILL (if enabled) ---------
        const makeSpectrumFillPath = () => {
          spCtx.beginPath();
          spCtx.moveTo(points[0].x, points[0].y);
          for (let i = 1; i < points.length; i++) {
            spCtx.lineTo(points[i].x, points[i].y);
          }
          spCtx.lineTo(wCss, hCss);
          spCtx.lineTo(0, hCss);
          spCtx.closePath();
        };

        const fillClippedGradient = (gradient, topY = 0, bottomY = hCss) => {
          if (!points.length || bottomY <= topY) return;
          spCtx.save();
          makeSpectrumFillPath();
          spCtx.clip();
          spCtx.fillStyle = gradient;
          spCtx.fillRect(0, topY, wCss, bottomY - topY);
          spCtx.restore();
        };

        if (fillMode === "rainbowGradient" && points.length) {
          const gradient = spCtx.createLinearGradient(0, hCss, 0, 0);
          gradient.addColorStop(0.0, "rgba(0,40,255,0.58)");
          gradient.addColorStop(0.22, "rgba(0,220,255,0.58)");
          gradient.addColorStop(0.43, "rgba(0,255,80,0.58)");
          gradient.addColorStop(0.64, "rgba(255,255,0,0.58)");
          gradient.addColorStop(0.82, "rgba(255,125,0,0.58)");
          gradient.addColorStop(1.0, "rgba(255,0,0,0.58)");
          fillClippedGradient(gradient);
        } else if (fillMode === "cyanGradient" && points.length) {
          const gradient = spCtx.createLinearGradient(0, hCss, 0, 0);
          gradient.addColorStop(0.0, "rgba(0,20,30,0.12)");
          gradient.addColorStop(0.55, "rgba(0,125,150,0.28)");
          gradient.addColorStop(1.0, "rgba(80,255,255,0.58)");
          fillClippedGradient(gradient);
        } else if (fillMode === "aurora" && points.length) {
          const gradient = spCtx.createLinearGradient(0, hCss, 0, 0);
          gradient.addColorStop(0.0, "rgba(0,4,18,0.22)");
          gradient.addColorStop(0.28, "rgba(0,28,100,0.40)");
          gradient.addColorStop(0.58, "rgba(0,220,235,0.50)");
          gradient.addColorStop(0.82, "rgba(25,255,115,0.56)");
          gradient.addColorStop(1.0, "rgba(235,255,255,0.66)");
          fillClippedGradient(gradient);
        } else if (fillMode === "heat" && points.length) {
          const gradient = spCtx.createLinearGradient(0, hCss, 0, 0);
          gradient.addColorStop(0.0, "rgba(0,0,0,0.10)");
          gradient.addColorStop(0.18, "rgba(0,20,100,0.38)");
          gradient.addColorStop(0.38, "rgba(105,0,150,0.48)");
          gradient.addColorStop(0.58, "rgba(230,0,40,0.54)");
          gradient.addColorStop(0.76, "rgba(255,110,0,0.60)");
          gradient.addColorStop(0.91, "rgba(255,240,0,0.66)");
          gradient.addColorStop(1.0, "rgba(255,255,255,0.72)");
          fillClippedGradient(gradient);
        } else if (fillMode === "glass" && points.length) {
          const gradient = spCtx.createLinearGradient(0, hCss, 0, 0);
          gradient.addColorStop(0.0, "rgba(0,40,255,0.16)");
          gradient.addColorStop(0.22, "rgba(0,220,255,0.18)");
          gradient.addColorStop(0.43, "rgba(0,255,80,0.20)");
          gradient.addColorStop(0.64, "rgba(255,255,0,0.22)");
          gradient.addColorStop(0.82, "rgba(255,125,0,0.24)");
          gradient.addColorStop(1.0, "rgba(255,255,255,0.30)");
          fillClippedGradient(gradient);
        } else if (fillMode === "adaptive" && points.length && bins.length) {
          // Estimate the noise floor from the lower 35 percent of FFT bins.
          // A percentile is steadier than the minimum and ignores isolated notches.
          const sortedBins = Array.from(bins)
            .filter(Number.isFinite)
            .sort((a, b) => a - b);
          if (sortedBins.length) {
            const noiseIndex = Math.min(
              sortedBins.length - 1,
              Math.max(0, Math.floor(sortedBins.length * 0.35)),
            );
            const noiseDb = sortedBins[noiseIndex] + 2.5;
            let noiseT = (noiseDb - floor) / (ceil - floor);
            noiseT = Math.max(0.03, Math.min(0.92, noiseT));
            const noiseY = hCss - noiseT * hCss;

            // Use a high percentile as the current visible peak. Mapping the
            // rainbow between the tracked floor and this level ensures that the
            // active display always reaches yellow/red instead of compressing all
            // useful signals into the blue end of the full dB scale.
            const peakIndex = Math.min(
              sortedBins.length - 1,
              Math.max(noiseIndex + 1, Math.floor(sortedBins.length * 0.995)),
            );
            const peakDb = Math.max(noiseDb + 12.0, sortedBins[peakIndex]);
            let peakT = (peakDb - floor) / (ceil - floor);
            peakT = Math.max(noiseT + 0.08, Math.min(0.99, peakT));
            const peakY = Math.max(0, hCss - peakT * hCss);

            // Keep the region below the tracked noise floor visibly filled with
            // subdued blue, then map the full rainbow from floor to visible peak.
            const belowFloor = spCtx.createLinearGradient(0, hCss, 0, noiseY);
            belowFloor.addColorStop(0.0, "rgba(0,18,70,0.34)");
            belowFloor.addColorStop(1.0, "rgba(0,40,255,0.46)");
            fillClippedGradient(belowFloor, noiseY, hCss);

            const aboveFloor = spCtx.createLinearGradient(0, noiseY, 0, peakY);
            aboveFloor.addColorStop(0.0, "rgba(0,40,255,0.50)");
            aboveFloor.addColorStop(0.2, "rgba(0,220,255,0.54)");
            aboveFloor.addColorStop(0.4, "rgba(0,255,80,0.57)");
            aboveFloor.addColorStop(0.62, "rgba(255,255,0,0.61)");
            aboveFloor.addColorStop(0.82, "rgba(255,125,0,0.65)");
            aboveFloor.addColorStop(1.0, "rgba(255,0,0,0.72)");
            fillClippedGradient(aboveFloor, peakY, noiseY);

            // Any exceptionally strong peaks above the adaptive peak percentile
            // remain red rather than reverting to transparent/black.
            if (peakY > 0) {
              fillClippedGradient("rgba(255,0,0,0.72)", 0, peakY);
            }
          }
        } else if (fillMode === "rainbow" && points.length > 1) {
          // Backward compatibility for settings saved by the earlier build.
          for (let i = 1; i < points.length; i++) {
            const a = points[i - 1];
            const b = points[i];
            const strength = (a.t + b.t) * 0.5;
            const hue = (1 - strength) * 240;
            const rgb = hslToRgb(hue / 360, 1, 0.5);
            spCtx.beginPath();
            spCtx.moveTo(a.x, a.y);
            spCtx.lineTo(b.x, b.y);
            spCtx.lineTo(b.x, hCss);
            spCtx.lineTo(a.x, hCss);
            spCtx.closePath();
            spCtx.fillStyle = `rgba(${rgb[0]},${rgb[1]},${rgb[2]},0.52)`;
            spCtx.fill();
          }
        } else if (fillMode === "linear" && points.length) {
          // Backward compatibility for the former Linear Cyan setting.
          makeSpectrumFillPath();
          spCtx.fillStyle = "rgba(0,255,255,0.32)";
          spCtx.fill();
        }

        // --------- STROKE TRACE ---------
        // Rebuild the open trace path so the fill baseline and side edges
        // are never stroked.
        if (points.length) {
          spCtx.beginPath();
          spCtx.moveTo(points[0].x, points[0].y);
          for (let i = 1; i < points.length; i++) {
            spCtx.lineTo(points[i].x, points[i].y);
          }
          spCtx.strokeStyle = "cyan";
          spCtx.lineWidth = 1;
          spCtx.stroke();
        }
        spCtx.restore();

        // --------- FIXED DEAD-AIR REGIONS ---------
        // Areas beyond the sampled FFT window use a stable grey background and
        // a locked floor.  They never borrow the fluctuating value of an edge bin.
        const drawDeadAir = (x, width, boundaryX) => {
          if (!(width > 0)) return;
          spCtx.save();
          spCtx.fillStyle = "rgba(115, 123, 134, 0.24)";
          spCtx.fillRect(x, 0, width, hCss);

          // Fixed floor at the bottom of the display.
          spCtx.strokeStyle = "rgba(185, 191, 199, 0.62)";
          spCtx.lineWidth = 1;
          spCtx.beginPath();
          spCtx.moveTo(x, hCss - 1.5);
          spCtx.lineTo(x + width, hCss - 1.5);
          spCtx.stroke();

          // Capture-edge divider.
          spCtx.strokeStyle = "rgba(205, 210, 218, 0.78)";
          spCtx.setLineDash([4, 4]);
          spCtx.beginPath();
          spCtx.moveTo(boundaryX + 0.5, 0);
          spCtx.lineTo(boundaryX + 0.5, hCss);
          spCtx.stroke();
          spCtx.setLineDash([]);
          spCtx.restore();
        };

        if (liveLeftPx > 0) drawDeadAir(0, liveLeftPx, liveLeftPx);
        if (liveRightPx < wCss)
          drawDeadAir(liveRightPx, wCss - liveRightPx, liveRightPx);

