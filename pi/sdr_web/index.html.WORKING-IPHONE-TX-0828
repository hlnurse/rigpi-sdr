            newLeftHz = _bwAnchorHz;
            newRightHz = dragHz;
          } else {
            newLeftHz = dragHz;
            newRightHz = _bwAnchorHz;
          }
          state.bw = Math.max(
            100,
            Math.min(20000, Math.round(newRightHz - newLeftHz)),
          );
