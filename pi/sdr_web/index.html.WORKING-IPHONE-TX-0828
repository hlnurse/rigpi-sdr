      function syncFibSelectionFromState() {
        const frequency = fibCurrentFrequency();
        if (!Number.isFinite(frequency)) return;

        let nextKey = null;
        let nextMemory = -1;

        // An exact Memory-panel frequency wins over an activity match.
        if (Array.isArray(memories)) {
          for (let index = 0; index < memories.length; index++) {
            const memory = memories[index];
            if (!memory || typeof memory !== "object") continue;
            const memoryFrequency = Number(memory.freq ?? memory.frequency);
            if (
              Number.isFinite(memoryFrequency) &&
              Math.abs(memoryFrequency - frequency) <= 1
            ) {
              nextKey = `memory:${index}`;
              nextMemory = index;
              break;
            }
          }
        }

        if (!nextKey && Array.isArray(fib.intelligenceObjects)) {
          const containing = fib.intelligenceObjects
            .filter(
              (object) => frequency >= object.start && frequency <= object.end,
            )
            .sort((a, b) => b.priority - a.priority || a.widthHz - b.widthHz);
          const object = containing[0];
          if (
            object &&
            Array.isArray(object.actions) &&
            object.actions.length
          ) {
            let bestIndex = 0;
            let bestDistance = Infinity;
            object.actions.forEach((action, index) => {
              const distance = Math.abs(Number(action.frequency) - frequency);
              if (distance < bestDistance) {
                bestDistance = distance;
                bestIndex = index;
              }
            });
            nextKey = `${object.id}:action:${bestIndex}`;
          }
        }

        if (nextMemory >= 0) activeMemIdx = nextMemory;
        if (fibSelectedActionKey !== nextKey) {
          fibSelectedActionKey = nextKey;
          refreshFibTooltipSelection();
          if (typeof renderMemGrid === "function") renderMemGrid();
        }
