            const inUseByOther = {};
            instances.forEach((inst) => {
              if (!inst.current && inst.device && inst.device !== "fake") {
                const devKey = inst.device_serial
                  ? inst.device_serial
                  : inst.device.toLowerCase();
                const label = "port " + inst.port;
                inUseByOther[devKey] = label;
                inUseByOther[inst.device.toLowerCase()] = label;
