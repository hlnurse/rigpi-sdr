      function fibBandwidthStep(mode) {
        const normalized = String(mode || "").toUpperCase();
        if (normalized === "CW" || normalized === "CWR") return 50;
        if (normalized === "AM") return 500;
        if (normalized === "FM" || normalized === "NFM") return 1000;
        if (normalized === "WFM") return 10000;
        return 100;
      }

      function selectedLedFrequencyStep() {
        // LED digit indexes run left-to-right from 100 MHz (index 0)
        // through 1 Hz (index 8). Shift+wheel follows the highlighted digit.
        const index = Number(activeDigit);
        if (!Number.isInteger(index) || index < 0 || index > 8) return 100;
        return Math.pow(10, 8 - index);
