      function fibCurrentFrequency() {
        const tuned = Number(state.tuned_freq);
        if (Number.isFinite(tuned) && tuned > 0) return tuned;
        const center = Number(state.center_freq);
        return Number.isFinite(center) && center > 0 ? center : NaN;
      }

      function refreshFibTooltipSelection() {
        if (
          !fibTooltip.hidden &&
          !fibTooltip.classList.contains("fib-closing") &&
          Number.isFinite(fibLastClientX) &&
          Number.isFinite(fibLastClientY)
        ) {
          showFibTargetAt(fibLastClientX, fibLastClientY);
        }
