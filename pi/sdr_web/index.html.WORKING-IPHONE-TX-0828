                a.style.color = "#4af";
                a.removeAttribute("data-sel");
              }
            });
          }
        };

        window._recDelete = function (name) {
          if (_recPlayingName === name) {
            [
              { audio: recPlayback, name: recPlaybackName },
              { audio: memRecPlayback, name: memRecPlaybackName },
            ].forEach((player) => {
              if (!player.audio) return;
              player.audio.pause();
              player.audio.removeAttribute("src");
              player.audio.load();
              player.audio.style.display = "none";
              if (player.name) player.name.textContent = "";
            });
            _recPlayingName = "";
            _recPlayingKind = "audio";
          }
          fetch(
            (window._sdrBase || "") +
              "/api/audio/recordings/" +
              encodeURIComponent(name),
            { method: "DELETE" },
          )
            .then(() => {
              if (window._recSelected === name) window._recSelected = null;
              _recRefreshList();
            })
            .catch(() => {});
        };

        let _recPrefix = "rec";
        let _recReason = "manual";

        function _recSafePrefix(value) {
          return (
            String(value || "rec")
              .replace(/[^A-Za-z0-9_-]+/g, "_")
              .replace(/^_+|_+$/g, "")
              .slice(0, 80) || "rec"
          );
        }

        function _recTimestamp(ts) {
          return (
            ts.getFullYear() +
            String(ts.getMonth() + 1).padStart(2, "0") +
            String(ts.getDate()).padStart(2, "0") +
            "_" +
            String(ts.getHours()).padStart(2, "0") +
            String(ts.getMinutes()).padStart(2, "0") +
            String(ts.getSeconds()).padStart(2, "0")
