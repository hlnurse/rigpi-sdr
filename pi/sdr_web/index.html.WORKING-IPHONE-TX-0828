        const tipRect = fibTooltip.getBoundingClientRect();
        const left = Math.max(
          8,
          Math.min(clientX + 10, window.innerWidth - tipRect.width - 8),
        );
        const top = Math.max(
          8,
          Math.min(
            clientY - tipRect.height - 10,
            window.innerHeight - tipRect.height - 8,
          ),
        );
