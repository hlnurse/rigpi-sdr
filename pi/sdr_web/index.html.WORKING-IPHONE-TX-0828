      });

      // Sync remote host list from fetchState
      function syncRemoteHosts(remoteHosts) {
        if (Array.isArray(remoteHosts)) renderRemoteHostList(remoteHosts);
      }
      renderFreqLED(state.center_freq);
      // add these defaults if not present yet
      state.mode = state.mode || "FM";
      state.bw = state.bw ?? null;
      buildBandPills();
      buildModePills();
      setAudioButtonUI();
      // Check if server still has an active audio session (survives refresh)
      fetch((window._sdrBase || "") + "/api/audio/state", { cache: "no-store" })
        .then((r) => r.json())
        .then((d) => {
          if (d.running) {
            // Only restore running state if audioCtx exists (user already interacted)
