# lxpanel <profile> config file. Manually editing is not recommended.
# Use preference dialog in lxpanel to adjust config when you can.

Global {
  edge=top
  align=left
  margin=0
  widthtype=percent
  width=100
  height=30
  transparent=0
  tintcolor=#000000
  alpha=0
  autohide=0
  heightwhenhidden=2
  setdocktype=1
  setpartialstrut=1
  usefontcolor=0
  fontsize=12
  fontcolor=#ffffff
  usefontsize=1
  background=0
  backgroundfile=/usr/share/lxpanel/images/background.png
  iconsize=30
  monitor=0
  point_at_menu=0
}
Plugin {
  type=menu
  Config {
    system {
    }
    separator {
    }
    item {
      command=run
    }
    separator {
    }
    item {
      command=logout
      image=gnome-logout
    }
    image=/usr/share/icons/PiXflat/32x32/apps/launch.png
  }
}
Plugin {
  type=separator
  Config {
  }
}
Plugin {
  type=launchbar
  Config {
    Button {
      id=/usr/share/applications/pcmanfm.desktop }
      Button {
        id=/usr/share/applications/lxterminal.desktop }
      }
    }
    Button {
      id=lxterminal.desktop
    }
    Button {
      id=pcmanfm.desktop
    }
    Button {
      id=firefox.desktop
    }
  }
}
Plugin {
  type=space
  Config {
  }
  expand=1
}
Plugin {
  type=tray
  Config {
  }
}
Plugin {
  type=volume
  Config {
  }
}
