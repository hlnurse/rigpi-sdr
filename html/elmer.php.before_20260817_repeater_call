function requestedRepeaterDirectorySearch(text){
  if(!/\brepeaters?\b/i.test(text)||!/\b(?:find|show|list|near|nearby|local|within|around)\b/i.test(text))return null;
  const distance=text.match(/\b(\d+(?:\.\d+)?)\s*(miles?|mi|kilometers?|kilometres?|km)\b/i);let radius=distance?Number(distance[1]):25;if(distance&&/^k/i.test(distance[2]))radius/=1.609344;
  const zip=(text.match(/\b(\d{5})\b/)||[])[1]||'';
  const place=text.match(/\b(?:of|near|around|in|from)\s+([A-Za-z .'-]+?)(?:\s*,\s*|\s+)([A-Za-z]{2})\s*[?.!]*$/i);
  const mode=/\bDMR\b/i.test(text)?'DMR':/\bD[ -]?STAR\b/i.test(text)?'D-STAR':/\b(?:YSF|Fusion)\b/i.test(text)?'YSF':/\bP25\b/i.test(text)?'P25':/\bNXDN\b/i.test(text)?'NXDN':/\bM17\b/i.test(text)?'M17':/\b(?:analog|FM)\b/i.test(text)?'FM':'';
  const band=/\b(?:10\s*(?:meter|metre)s?|10m)\b/i.test(text)?'10m':/\b(?:6\s*(?:meter|metre)s?|6m)\b/i.test(text)?'6m':/\b(?:2\s*(?:meter|metre)s?|2m|144|146)\b/i.test(text)?'2m':/\b(?:1\.25\s*(?:meter|metre)s?|1\.25m|220|222)\b/i.test(text)?'1.25m':/\b(?:70\s*(?:centimeter|centimetre)s?|70cm|440)\b/i.test(text)?'70cm':/\b(?:33\s*(?:centimeter|centimetre)s?|33cm|900)\b/i.test(text)?'33cm':/\b(?:23\s*(?:centimeter|centimetre)s?|23cm|1\.2\s*GHz)\b/i.test(text)?'23cm':'';
  const request={center:'user',radius_miles:Math.max(.1,Math.min(250,radius)),mode,band,limit:25};
  if(zip){request.center='postal';request.postal_code=zip}else if(place&&!/^(?:me|here)$/i.test(place[1].trim())){request.center='city';request.center_city=place[1].replace(/^\d+(?:\.\d+)?\s*(?:miles?|mi|kilometers?|kilometres?|km)\s+(?:of|from|around)\s+/i,'').trim();request.center_state=place[2].toUpperCase()}
  return request
}
function repeaterFrequency(value){const hz=Number(value);return Number.isFinite(hz)?`${(hz/1e6).toFixed(3)} MHz`:'—'}
function repeaterOffset(value){const hz=Number(value);if(!Number.isFinite(hz)||hz===0)return 'simplex';return `${hz>0?'+':'−'}${Math.abs(hz/1e6).toFixed(3)} MHz`}
function repeaterTone(row){const encode=String(row.encode||'').trim(),decode=String(row.decode||'').trim();return [encode&&!/^0(?:\.0+)?$/.test(encode)?`Tx ${encode}`:'',decode&&!/^0(?:\.0+)?$/.test(decode)&&decode!==encode?`Rx ${decode}`:''].filter(Boolean).join(' / ')||'—'}
